---
/**
 * Layout base: estructura <html>, <head> y estilos globales.
 * Todas las páginas se envuelven con este layout.
 */
import Head from '../components/Head.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <Head title={title} description={description} />
  </head>

  <body class="bg-brand-black text-brand-white font-sans antialiased relative selection:bg-brand-red selection:text-white">
    <slot />
  </body>
</html>
