---
/**
 * Banner principal (hero) de la página de inicio.
 */
import { site } from '../config/site';
import { whatsappLink } from '../lib/whatsapp';

/** Insignias que aparecen debajo del texto principal. */
const beneficios = [
  { icono: 'fa-solid fa-check-circle', texto: 'Calidad garantizada' },
  { icono: 'fa-solid fa-snowflake', texto: 'Cadena de frío' },
  { icono: 'fa-solid fa-truck-fast', texto: 'Entregas rápidas' },
];
---

<section
  class="relative min-h-[100dvh] flex flex-col items-center justify-center pt-20 md:pt-24 pb-8 md:pb-4 overflow-hidden"
>
  <div class="absolute inset-0 z-0 pointer-events-none">
    <img
      src="/images/background2.png"
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      class="w-full h-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-brand-black/90 via-brand-black/75 to-brand-black/90"></div>
    <div class="absolute inset-0 bg-texture opacity-20 mix-blend-overlay"></div>
  </div>

  <div
    class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col justify-center items-center w-full mt-4 md:mt-10"
  >
    <span
      class="text-brand-gold font-semibold tracking-widest uppercase text-[10px] md:text-sm mb-3 md:mb-6 block drop-shadow-md"
      data-aos="fade-down"
    >
      Restaurantes &amp; Distribuidores
    </span>
    <h1
      class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-bold text-brand-white mb-4 md:mb-6 uppercase tracking-tight leading-[1.1] drop-shadow-2xl"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      Todos nuestros productos <br />
      <span class="text-brand-gold italic font-normal">en un solo catálogo</span>
    </h1>
    <p
      class="mt-2 md:mt-4 text-base md:text-xl text-brand-gray max-w-2xl mx-auto font-light mb-6 md:mb-12 drop-shadow-md"
      data-aos="fade-up"
      data-aos-delay="200"
    >
      Abastece tu negocio con los mejores cortes y embutidos. Especialistas en sabor, fuerza y rendimiento.
    </p>

    <div
      class="flex flex-col sm:flex-row justify-center items-center gap-3 sm:gap-6 mb-8 md:mb-12"
      data-aos="fade-up"
      data-aos-delay="300"
    >
      {
        beneficios.map((b) => (
          <div class="w-60 flex items-center justify-center gap-3 text-brand-white/90 bg-brand-black/80 py-2.5 rounded-sm backdrop-blur-md border border-brand-gold/20 shadow-lg">
            <i class={`${b.icono} text-brand-gold text-sm md:text-base`} />
            <span class="text-xs md:text-sm tracking-wide">{b.texto}</span>
          </div>
        ))
      }
    </div>

    <a
      href={whatsappLink(site.whatsappMessages.hero)}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 md:gap-3 bg-brand-red hover:bg-brand-redHover text-white font-bold py-3 px-6 md:py-4 md:px-8 rounded-sm text-base md:text-lg transition-all transform hover:scale-105 shadow-[0_0_30px_rgba(142,22,0,0.6)] border border-brand-redHover"
      data-aos="zoom-in"
      data-aos-delay="400"
    >
      <i class="fa-brands fa-whatsapp text-xl md:text-2xl"></i>
      Solicitar por WhatsApp
    </a>
  </div>

  <div class="relative z-10 w-full flex justify-center animate-bounce cursor-pointer mt-10 md:mt-16 shrink-0">
    <a
      href="#catalogo"
      class="text-brand-white/40 hover:text-brand-gold transition-colors flex flex-col items-center gap-1 md:gap-2"
    >
      <span class="text-[9px] md:text-[10px] uppercase tracking-widest font-bold">Explorar</span>
      <i class="fa-solid fa-chevron-down text-xl md:text-2xl"></i>
    </a>
  </div>
</section>
