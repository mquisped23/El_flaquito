---
/**
 * Banner principal (hero).
 * Secuencia de entrada: la parrilla "se enciende", el titular sube línea por
 * línea, el producto cae sobre la parrilla y suelta una ráfaga de chispas.
 * Las brasas (canvas) suben siempre y se apartan del cursor.
 */
import { site } from '../config/site';
import { whatsappLink } from '../lib/whatsapp';
import Button from './ui/Button.astro';

/** Producto que aparece en el hero (imagen sin fondo, cuadrada). */
const producto = {
  src: '/images/products/hamburguesa de carne.webp',
  alt: 'Paquete de Hamburguesa de Carne El Flaquito con hamburguesas crudas apiladas',
};

const beneficios = [
  { icono: 'fa-solid fa-circle-check', texto: 'Calidad garantizada' },
  { icono: 'fa-solid fa-snowflake', texto: 'Cadena de frío' },
  { icono: 'fa-solid fa-truck-fast', texto: 'Entregas rápidas' },
];
---

<section id="inicio" class="hero" data-hero>
  <!-- Fondo: parrilla que se enciende -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-move">
      <img class="hero-bg-img" src="/images/background2.webp" alt="" width="1536" height="1024" fetchpriority="high" />
    </div>
    <div class="hero-scrim"></div>
    <div class="hero-heat"></div>
  </div>

  <canvas class="hero-embers" aria-hidden="true" data-embers></canvas>

  <div class="hero-grid">
    <div class="hero-head hero-out">
      <h1 class="hero-title font-heading font-bold text-brand-white">
        <span class="hero-line"><span class="hero-line-in">Todos nuestros productos</span></span>
        <span class="hero-line hero-line--gold"
          ><span class="hero-line-in" data-glow="en un solo catálogo">en un solo catálogo</span></span
        >
      </h1>
    </div>

    <div class="hero-copy hero-out">
      <p class="hero-lead hero-reveal" style="--d: 1.05s">
        Abastece tu restaurante o distribuidora con los mejores cortes y embutidos. Especialistas en sabor, fuerza y
        rendimiento.
      </p>

      <div class="hero-actions hero-reveal" style="--d: 1.2s">
        <Button href={whatsappLink(site.whatsappMessages.hero)} variant="primary" size="lg" icon="fa-brands fa-whatsapp" external>
          Solicitar por WhatsApp
        </Button>
        <Button
          href={encodeURI(site.catalogoPdf.href)}
          variant="gold"
          size="lg"
          icon="fa-solid fa-file-pdf"
          trailingIcon="fa-solid fa-arrow-down"
          download
          sublabel={`PDF · ${site.catalogoPdf.peso}`}
          aria-label={`Descargar catálogo en PDF (${site.catalogoPdf.peso})`}
        >
          Descargar catálogo
        </Button>
      </div>

      <ul class="hero-facts hero-reveal" style="--d: 1.35s">
        {
          beneficios.map((b) => (
            <li>
              <i class={b.icono} aria-hidden="true" />
              {b.texto}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-product" data-hero-product>
      <div class="hero-product-tilt" data-tilt>
        <div class="hero-product-float">
          <img
            class="hero-product-img"
            src={encodeURI(producto.src)}
            alt={producto.alt}
            width="2048"
            height="2048"
            fetchpriority="high"
            data-hero-drop
          />
        </div>
      </div>
      <div class="hero-product-shadow" aria-hidden="true"></div>
    </div>
  </div>

  <a href="#catalogo" class="hero-cue">
    <span>Ver catálogo</span>
    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
  </a>
</section>

<style>
  /* ==================================================================
     Estructura
  ================================================================== */
  .hero {
    --p: 0; /* progreso del scroll al salir del hero (0 → 1) */
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: hidden;
    background: #070605;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.5rem;
    align-content: center;
    width: 100%;
    max-width: 80rem;
    min-height: 100svh;
    margin-inline: auto;
    padding: 6.5rem 1rem 5.5rem;
  }

  @media (min-width: 640px) {
    .hero-grid {
      padding-inline: 1.5rem;
    }
  }

  .hero-head {
    container-type: inline-size;
  }

  /* Móvil: titular, producto, texto */
  .hero-product {
    order: 2;
  }

  .hero-copy {
    order: 3;
  }

  @media (min-width: 1024px) {
    /* Escritorio: titular a todo el ancho; debajo texto (izq.) y producto (der.) */
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: auto auto;
      align-content: center;
      column-gap: 2rem;
      row-gap: 2.25rem;
      padding: 7.25rem 2rem 4rem;
    }

    .hero-head {
      grid-column: 1 / -1;
      grid-row: 1;
      position: relative;
      z-index: 2;
    }

    .hero-copy {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
    }

    .hero-product {
      grid-column: 2;
      grid-row: 2;
      align-self: start;
      margin-top: -3.5rem;
    }
  }

  /* ==================================================================
     Fondo
  ================================================================== */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-move {
    position: absolute;
    inset: -6% 0;
    transform: translate3d(0, calc(var(--p) * 18%), 0);
    will-change: transform;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 60%;
    animation:
      ignite 2.6s var(--ease-out) both,
      drift 26s ease-in-out 2.6s infinite alternate;
  }

  /* El "encendido" oscurece con una capa negra que se desvanece (solo opacidad),
     en vez de animar filter: brightness sobre una imagen a pantalla completa. */
  .hero-bg-move::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #070605;
    opacity: 0;
    pointer-events: none;
    animation: ignite-dark 2.6s var(--ease-out) backwards;
  }

  @keyframes ignite-dark {
    from {
      opacity: 0.85;
    }
  }

  @keyframes ignite {
    0% {
      transform: scale(1.22);
    }
    100% {
      transform: scale(1.06);
    }
  }

  /* Fuera de pantalla: las animaciones infinitas se pausan y no gastan CPU */
  .hero[data-offscreen] *,
  .hero[data-offscreen] *::after {
    animation-play-state: paused !important;
  }

  /* Modo ligero (equipos sin aceleración gráfica): el fondo queda quieto */
  .hero[data-lite] .hero-bg-img {
    animation-play-state: paused;
  }

  @keyframes drift {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1.13) translate(-1.5%, -1%);
    }
  }

  /* Oscurece el lado del texto (en móvil, todo arriba) */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(7 6 5 / 0.82) 0%, rgb(7 6 5 / 0.55) 45%, rgb(7 6 5 / 0.9) 100%);
  }

  @media (min-width: 1024px) {
    .hero-scrim {
      background:
        linear-gradient(90deg, rgb(7 6 5 / 0.95) 0%, rgb(7 6 5 / 0.82) 34%, rgb(7 6 5 / 0.2) 62%, rgb(7 6 5 / 0.1) 100%),
        linear-gradient(180deg, rgb(7 6 5 / 0.45) 0%, transparent 25%, transparent 70%, rgb(10 10 10 / 1) 100%);
    }
  }

  /* Calor de las brasas: titila como fuego real */
  .hero-heat {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 55% 45% at 78% 92%, rgb(255 96 20 / 0.26), transparent 70%);
    animation: flicker 3.8s steps(1, end) 2s infinite;
    opacity: 0.8;
  }

  @keyframes flicker {
    0%,
    100% {
      opacity: 0.8;
    }
    12% {
      opacity: 0.62;
    }
    19% {
      opacity: 0.92;
    }
    33% {
      opacity: 0.7;
    }
    47% {
      opacity: 1;
    }
    58% {
      opacity: 0.74;
    }
    71% {
      opacity: 0.88;
    }
    86% {
      opacity: 0.66;
    }
  }

  .hero-embers {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ==================================================================
     Texto
  ================================================================== */
  .hero-out {
    position: relative;
    transform: translate3d(0, calc(var(--p) * -70px), 0);
    opacity: calc(1 - var(--p) * 1.3);
  }

  /* En teléfonos el titular puede ocupar 3 líneas para mantener un tamaño grande */
  .hero-title {
    font-size: clamp(2.35rem, 10vw, 3rem);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  /* Desde tablet: siempre 2 líneas. La línea 1 mide ~11.4 veces el tamaño de letra,
     así que 8.6% del ancho del contenedor (cqi) garantiza que entre. */
  @media (min-width: 640px) {
    .hero-title {
      font-size: min(8.6cqi, 6rem, 11svh);
    }

    .hero-line-in {
      white-space: nowrap;
    }
  }

  /* Cada línea sube desde una máscara */
  .hero-line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em 0.12em;
    margin-block: -0.06em -0.12em;
  }

  .hero-line-in {
    display: block;
    animation: line-up 1.1s var(--ease-out) both;
    animation-delay: 0.55s;
  }

  .hero-line--gold .hero-line-in {
    position: relative;
    color: var(--gold);
    font-style: italic;
    font-weight: 600;
    animation: line-up 1.1s var(--ease-out) 0.7s both;
  }

  @keyframes line-up {
    from {
      transform: translateY(105%) rotate(2deg);
    }
  }

  /* Resplandor de calor: la sombra se pinta una sola vez en su propia capa
     y solo se anima la opacidad (animar text-shadow repinta el texto en cada frame). */
  .hero-line--gold .hero-line-in::after {
    content: attr(data-glow);
    content: attr(data-glow) / ''; /* decorativo: no lo leen los lectores de pantalla */
    position: absolute;
    inset: 0;
    color: transparent;
    text-shadow: 0 0 28px rgb(255 140 40 / 0.35);
    pointer-events: none;
    user-select: none;
    opacity: 0;
    will-change: opacity;
    animation: heat-glow 4s ease-in-out 2.2s infinite;
  }

  @keyframes heat-glow {
    50% {
      opacity: 1;
    }
  }

  .hero-lead {
    max-width: 34rem;
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    font-weight: 300;
    color: rgb(249 250 251 / 0.85);
  }

  @media (min-width: 1024px) {
    .hero-lead {
      margin-top: 2rem;
      font-size: 1.25rem;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2rem;
  }

  @media (max-width: 639px) {
    .hero-actions :global(.btn) {
      width: 100%;
      justify-content: flex-start;
    }

    .hero-actions :global(.btn-trail) {
      margin-left: auto;
    }
  }

  @media (min-width: 1024px) {
    .hero-actions {
      margin-top: 2.75rem;
      gap: 1rem;
    }
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-top: 2rem;
    font-size: 0.9375rem;
    color: rgb(249 250 251 / 0.85);
  }

  .hero-facts li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero-facts i {
    color: var(--gold);
  }

  .hero-reveal {
    animation: reveal 1s var(--ease-out) both;
    animation-delay: var(--d, 1s);
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  /* ==================================================================
     Producto
  ================================================================== */
  .hero-product {
    position: relative;
    z-index: 1;
    justify-self: center;
    width: min(64vw, 19rem, 34svh);
    margin-block: -1rem -0.5rem;
    transform: translate3d(0, calc(var(--p) * -140px), 0) scale(calc(1 - var(--p) * 0.12));
  }

  /* Teléfonos bajos: primero el texto y los botones, el producto después */
  @media (max-width: 1023px) and (max-height: 740px) {
    .hero-product {
      order: 4;
      margin-top: 0.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-product {
      width: min(40vw, 36rem, 54svh);
      justify-self: end;
      margin-right: -1.5rem;
    }
  }

  .hero-product-tilt {
    perspective: 900px;
    transform: rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg));
    transition: transform 0.6s var(--ease-out);
  }

  .hero-product-float {
    animation: float 6s ease-in-out 2.4s infinite;
  }

  /* Sombras y resplandor con degradados (se pintan una vez). Un filter: drop-shadow
     sobre la imagen se recalcula en cada frame mientras el producto flota. */
  .hero-product::before {
    content: '';
    position: absolute;
    inset: 4% 0 6%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 110 30 / 0.16), transparent);
    animation: shadow-in 1.25s var(--ease-out) 0.9s backwards;
  }

  .hero-product-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    animation: drop-in 1.25s cubic-bezier(0.2, 0.85, 0.25, 1.08) 0.9s backwards;
  }

  .hero-product-shadow {
    position: absolute;
    left: 10%;
    right: 4%;
    bottom: 4%;
    height: 16%;
    border-radius: 50%;
    background: radial-gradient(closest-side at center, rgb(0 0 0 / 0.85), rgb(0 0 0 / 0.4) 55%, transparent);
    animation: shadow-in 1.25s var(--ease-out) 0.9s backwards;
  }

  @keyframes drop-in {
    0% {
      opacity: 0;
      transform: translate3d(8%, -55%, 0) rotate(-16deg) scale(1.18);
    }
    55% {
      opacity: 1;
    }
    100% {
      transform: none;
    }
  }

  @keyframes shadow-in {
    from {
      opacity: 0;
      transform: scale(0.3);
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(-1deg);
    }
  }

  /* ==================================================================
     Indicador de scroll
  ================================================================== */
  .hero-cue {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    z-index: 3;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgb(249 250 251 / 0.6);
    transform: translateX(-50%);
    transition: color 0.3s ease;
    animation: reveal 1s var(--ease-out) 1.8s both;
  }

  @media (min-width: 1024px) and (min-height: 760px) {
    .hero-cue {
      display: flex;
    }
  }

  .hero-cue:hover,
  .hero-cue:focus-visible {
    color: var(--gold);
  }

  .hero-cue:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .hero-cue i {
    animation: nudge 1.8s ease-in-out infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  /* ==================================================================
     Movimiento reducido: todo aparece quieto
  ================================================================== */
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-img,
    .hero-bg-move::after,
    .hero-product::before,
    .hero-heat,
    .hero-line-in,
    .hero-line--gold .hero-line-in,
    .hero-line--gold .hero-line-in::after,
    .hero-reveal,
    .hero-product-img,
    .hero-product-shadow,
    .hero-product-float,
    .hero-cue,
    .hero-cue i {
      animation: none !important;
    }

    .hero-bg-img {
      transform: scale(1.06);
    }

    .hero-embers {
      display: none;
    }

    .hero-out,
    .hero-product,
    .hero-bg-move {
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-embers]');
  const product = document.querySelector<HTMLElement>('[data-hero-product]');
  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  const dropImg = document.querySelector<HTMLImageElement>('[data-hero-drop]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero) {
    // ---------- Salida con scroll (parallax) ----------
    let scrollTicking = false;
    const onScroll = () => {
      scrollTicking = false;
      const p = Math.min(1, Math.max(0, window.scrollY / hero.offsetHeight));
      hero.style.setProperty('--p', p.toFixed(3));
    };
    if (!reduceMotion) {
      window.addEventListener(
        'scroll',
        () => {
          if (!scrollTicking) {
            scrollTicking = true;
            requestAnimationFrame(onScroll);
          }
        },
        { passive: true },
      );
      onScroll();
    }

    // ---------- Inclinación 3D del producto con el mouse ----------
    if (tilt && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        tilt.style.setProperty('--rx', `${(x * 14).toFixed(2)}deg`);
        tilt.style.setProperty('--ry', `${(-y * 10).toFixed(2)}deg`);
      });
      hero.addEventListener('pointerleave', () => {
        tilt.style.setProperty('--rx', '0deg');
        tilt.style.setProperty('--ry', '0deg');
      });
    }
  }

  // ==================================================================
  // Brasas en canvas
  // ==================================================================
  if (hero && canvas && !reduceMotion) {
    const ctx = canvas.getContext('2d');

    type Ember = { x: number; y: number; vx: number; vy: number; r: number; life: number; max: number; hue: number; seed: number };

    if (ctx) {
      const embers: Ember[] = [];
      const pointer = { x: -9999, y: -9999 };
      let w = 0;
      let h = 0;
      let dpr = 1;
      let running = false;
      let raf = 0;
      let last = performance.now();

      const isDesktop = () => window.innerWidth >= 1024;
      // Modo ligero: si el equipo no sostiene la animación, menos brasas y canvas a menor resolución
      let lite = false;
      const target = () => (isDesktop() ? 90 : 40) / (lite ? 2 : 1);

      // Las brasas son puntos difusos: no necesitan resolución retina
      const resize = () => {
        dpr = lite ? 0.75 : 1;
        w = hero.clientWidth;
        h = hero.clientHeight;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const spawn = (x?: number, y?: number, burst = false): Ember => {
        // Nacen sobre la parrilla (abajo a la derecha en escritorio)
        const sx = x ?? (isDesktop() ? w * (0.45 + Math.random() * 0.55) : w * Math.random());
        const sy = y ?? h * (0.72 + Math.random() * 0.35);
        const angle = burst ? -Math.PI / 2 + (Math.random() - 0.5) * 2.2 : -Math.PI / 2 + (Math.random() - 0.5) * 0.5;
        const speed = burst ? 2.2 + Math.random() * 4.2 : 0.35 + Math.random() * 1.1;
        const max = burst ? 0.9 + Math.random() * 1.2 : 3 + Math.random() * 5;
        return {
          x: sx,
          y: sy,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          r: burst ? 0.8 + Math.random() * 1.8 : 0.6 + Math.random() * 1.9,
          life: 0,
          max,
          hue: 18 + Math.random() * 26,
          seed: Math.random() * 1000,
        };
      };

      // Ráfaga de chispas cuando el producto "cae" en la parrilla
      const burst = () => {
        if (!product) return;
        const hr = hero.getBoundingClientRect();
        const pr = product.getBoundingClientRect();
        const cx = pr.left - hr.left + pr.width * 0.55;
        const cy = pr.top - hr.top + pr.height * 0.82;
        for (let i = 0; i < 70; i++) embers.push(spawn(cx + (Math.random() - 0.5) * pr.width * 0.6, cy, true));
      };

      // Medidor de fluidez: tras la intro, mide 60 frames (o 1.5 s si va muy lento);
      // si la mediana supera 24 ms (< ~42 fps), activa el modo ligero una sola vez.
      const bornAt = performance.now();
      let startedAt = bornAt;
      const samples: number[] = [];
      let sampled = 0;
      const checkPerf = (frameMs: number, now: number) => {
        // Solo mide con el hero arriba y quieto (el scroll y el catálogo no cuentan)
        if (lite || now - bornAt < 3200 || frameMs > 250 || window.scrollY > 40 || now - startedAt < 500) return;
        samples.push(frameMs);
        sampled += frameMs;
        if (samples.length < 60 && sampled < 1500) return;
        const sorted = [...samples].sort((a, b) => a - b);
        const median = sorted[Math.floor(sorted.length / 2)];
        samples.length = 0;
        sampled = 0;
        if (median > 24) {
          lite = true;
          hero.dataset.lite = '';
          embers.length = Math.min(embers.length, target());
          resize();
        }
      };

      const step = (now: number) => {
        checkPerf(now - last, now);
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        ctx.clearRect(0, 0, w, h);
        ctx.globalCompositeOperation = 'lighter';

        while (embers.length < target()) embers.push(spawn());

        for (let i = embers.length - 1; i >= 0; i--) {
          const e = embers[i];
          e.life += dt;
          if (e.life > e.max || e.y < -20) {
            embers.splice(i, 1);
            continue;
          }

          // Viento suave + oscilación
          e.vx += Math.sin((now / 1000) * 1.3 + e.seed) * 0.012;
          e.vy -= 0.004; // el aire caliente sube
          e.vx *= 0.99;

          // Se apartan del cursor
          const dx = e.x - pointer.x;
          const dy = e.y - pointer.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < 120 * 120) {
            const f = (1 - Math.sqrt(d2) / 120) * 0.6;
            e.vx += (dx / 120) * f;
            e.vy += (dy / 120) * f;
          }

          e.x += e.vx * 60 * dt;
          e.y += e.vy * 60 * dt;

          const t = e.life / e.max;
          const flicker = 0.65 + Math.sin(now / 60 + e.seed) * 0.35;
          const alpha = Math.max(0, Math.min(1, t < 0.15 ? t / 0.15 : 1 - (t - 0.15) / 0.85)) * flicker;

          ctx.fillStyle = `hsla(${e.hue}, 100%, 55%, ${alpha * 0.18})`;
          ctx.beginPath();
          ctx.arc(e.x, e.y, e.r * 4, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = `hsla(${e.hue + 15}, 100%, ${70 + (1 - t) * 20}%, ${alpha})`;
          ctx.beginPath();
          ctx.arc(e.x, e.y, e.r, 0, Math.PI * 2);
          ctx.fill();
        }

        if (running) raf = requestAnimationFrame(step);
      };

      const start = () => {
        if (running) return;
        running = true;
        last = startedAt = performance.now();
        raf = requestAnimationFrame(step);
      };
      const stop = () => {
        running = false;
        cancelAnimationFrame(raf);
      };

      resize();
      window.addEventListener('resize', resize);

      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        pointer.x = e.clientX - r.left;
        pointer.y = e.clientY - r.top;
      });
      hero.addEventListener('pointerleave', () => {
        pointer.x = pointer.y = -9999;
      });

      // Solo se anima mientras el hero está en pantalla y la pestaña visible
      // rootMargin -1px arriba: cuando el catálogo queda justo en el borde del hero,
      // el hero cuenta como fuera de pantalla, y al seguir subiendo vuelve a "entrar"
      // (el observador solo avisa cuando cambia isIntersecting).
      let visible = true;
      new IntersectionObserver(
        (entries) => {
          visible = entries[entries.length - 1].isIntersecting;
          hero.toggleAttribute('data-offscreen', !visible);
          if (visible && !document.hidden) start();
          else stop();
        },
        { rootMargin: '-1px 0px 0px 0px' },
      ).observe(hero);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else if (visible) start();
      });

      dropImg?.addEventListener('animationend', (e) => {
        if (e.animationName.includes('drop-in')) burst();
      });

      start();
    }
  }
</script>
