---
/**
 * Cierre de la página: franja con los productos desfilando y la llamada final
 * ("Abastece tu negocio con calidad premium") sobre la parrilla encendida,
 * con los tres caminos de contacto: WhatsApp, catálogo PDF y teléfono.
 */
import { site } from '../config/site';
import { whatsappLink } from '../lib/whatsapp';
import { productos, nombreCompleto } from '../data/productos';
import Button from './ui/Button.astro';

const nombres = productos.map(nombreCompleto);
---

<section class="cta" aria-labelledby="cta-title" data-cta>
  <!-- Franja con los productos desfilando -->
  <div class="cta-marquee" aria-hidden="true">
    <div class="cta-track">
      {
        [0, 1].map(() => (
          <div class="cta-group">
            {nombres.map((nombre, k) => (
              <>
                <span class:list={['cta-word', { 'cta-word--outline': k % 2 === 1 }]}>{nombre}</span>
                <i class="fa-solid fa-star cta-star" />
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Llamada final -->
  <div class="cta-main">
    <div class="cta-bg" aria-hidden="true">
      <img src="/images/background1.webp" alt="" width="1536" height="1024" loading="lazy" decoding="async" />
    </div>
    <div class="cta-scrim" aria-hidden="true"></div>

    <div class="cta-inner">
      <h2 id="cta-title" class="cta-title font-heading font-bold">
        <span class="cta-line"><span class="cta-line-in">Abastece tu negocio</span></span>
        <span class="cta-line cta-line--gold"><span class="cta-line-in">con calidad premium</span></span>
      </h2>

      <p class="cta-lead cta-rise" style="--i: 0">
        Solicita nuestra lista de precios para mayoristas y recibe asesoría personalizada de un ejecutivo de cuenta.
      </p>

      <div class="cta-actions cta-rise" style="--i: 1">
        <Button
          href={whatsappLink(site.whatsappMessages.general)}
          variant="primary"
          size="lg"
          icon="fa-brands fa-whatsapp"
          trailingIcon="fa-solid fa-arrow-right"
          external
        >
          Cotizar vía WhatsApp
        </Button>
        <Button
          href={encodeURI(site.catalogoPdf.href)}
          variant="gold"
          size="lg"
          icon="fa-solid fa-file-pdf"
          trailingIcon="fa-solid fa-arrow-down"
          download
          sublabel={`PDF · ${site.catalogoPdf.peso}`}
          aria-label={`Descargar catálogo en PDF (${site.catalogoPdf.peso})`}
        >
          Descargar catálogo
        </Button>
      </div>

      <a href={`tel:+${site.contact.whatsapp}`} class="cta-phone cta-rise" style="--i: 2">
        <i class="fa-solid fa-phone" aria-hidden="true"></i>
        <span>o llámanos al <strong>{site.contact.phoneDisplay}</strong></span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    --p: 0;
    position: relative;
    isolation: isolate;
    background: #0a0a0a;
  }

  /* ==================================================================
     Franja de productos
  ================================================================== */
  .cta-marquee {
    position: relative;
    z-index: 2;
    overflow: hidden;
    padding-block: 1.75rem;
    background: #0a0a0a;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .cta-track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
    will-change: transform;
  }

  .cta[data-paused] .cta-track {
    animation-play-state: paused;
  }

  .cta-group {
    display: flex;
    align-items: center;
    flex: none;
  }

  .cta-word {
    padding-inline: 1.75rem;
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.25rem, 5.5vw, 4.5rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1.1;
    white-space: nowrap;
    color: #f9fafb;
  }

  .cta-word--outline {
    color: transparent;
    -webkit-text-stroke: 1px var(--gold);
  }

  .cta-star {
    font-size: clamp(0.9rem, 1.6vw, 1.25rem);
    color: var(--red-hi);
  }

  @keyframes marquee {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* ==================================================================
     Llamada final sobre la parrilla
  ================================================================== */
  .cta-main {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 34rem;
  }

  @media (min-width: 1024px) {
    .cta-main {
      min-height: min(48rem, 92svh);
    }
  }

  .cta-bg {
    position: absolute;
    inset: -10% 0;
    z-index: -2;
    transform: translate3d(0, calc((var(--p) - 0.5) * 12%), 0);
  }

  .cta-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 60%;
  }

  /* Oscurece el lado del texto; en móvil, toda la parte superior */
  .cta-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, #0a0a0a 0%, rgb(10 10 10 / 0.55) 22%, rgb(10 10 10 / 0.75) 60%, rgb(10 10 10 / 0.92) 100%);
  }

  @media (min-width: 1024px) {
    .cta-scrim {
      background:
        linear-gradient(180deg, #0a0a0a 0%, transparent 18%, transparent 80%, #050505 100%),
        linear-gradient(90deg, rgb(10 10 10 / 0.92) 0%, rgb(10 10 10 / 0.7) 38%, transparent 70%);
    }
  }

  .cta-inner {
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: 4.5rem 1rem 5rem;
  }

  @media (min-width: 640px) {
    .cta-inner {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .cta-inner {
      padding: 6rem 2rem;
    }
  }

  .cta-title {
    font-size: clamp(2.6rem, 6vw, 5.25rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #f9fafb;
  }

  .cta-line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em 0.12em;
    margin-block: -0.06em -0.12em;
  }

  .cta-line-in {
    display: block;
    transition: transform 1.1s var(--ease-out);
  }

  .cta-line--gold .cta-line-in {
    color: var(--gold);
    font-style: italic;
    font-weight: 600;
    transition-delay: 0.15s;
  }

  .cta-lead {
    max-width: 32rem;
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    font-weight: 300;
    color: rgb(249 250 251 / 0.85);
  }

  @media (min-width: 1024px) {
    .cta-lead {
      font-size: 1.1875rem;
    }
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2.25rem;
  }

  @media (max-width: 639px) {
    .cta-actions :global(.btn) {
      width: 100%;
      justify-content: flex-start;
    }

    .cta-actions :global(.btn-trail) {
      margin-left: auto;
    }
  }

  .cta-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    font-size: 0.9375rem;
    color: rgb(249 250 251 / 0.75);
    text-decoration: underline;
    text-decoration-color: rgb(197 160 89 / 0.4);
    text-underline-offset: 5px;
    transition:
      color 0.3s ease,
      text-decoration-color 0.3s ease;
  }

  .cta-phone i {
    color: var(--gold);
    font-size: 0.85rem;
  }

  .cta-phone strong {
    font-weight: 600;
    color: #f9fafb;
  }

  .cta-phone:hover {
    color: #f9fafb;
    text-decoration-color: var(--gold);
  }

  .cta-phone:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* ==================================================================
     Entrada
  ================================================================== */
  :global(html.js) .cta:not([data-in]) .cta-line-in {
    transform: translateY(105%) rotate(2deg);
  }

  :global(html.js) .cta:not([data-in]) .cta-rise {
    opacity: 0;
    transform: translateY(20px);
  }

  .cta-rise {
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.9s var(--ease-out),
      color 0.3s ease,
      text-decoration-color 0.3s ease;
    transition-delay: calc(0.4s + var(--i, 0) * 0.1s);
  }

  :global(html.js) .cta[data-settled] .cta-rise {
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-track {
      animation: none;
    }

    .cta-line-in,
    .cta-rise {
      transition: none !important;
    }

    :global(html.js) .cta .cta-line-in,
    :global(html.js) .cta .cta-rise {
      transform: none !important;
      opacity: 1 !important;
    }

    .cta-bg {
      transform: none;
    }
  }
</style>

<script>
  const cta = document.querySelector<HTMLElement>('[data-cta]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (cta) {
    // Entrada (una vez)
    new IntersectionObserver(
      (entries, obs) => {
        if (entries.some((e) => e.isIntersecting)) {
          cta.setAttribute('data-in', '');
          setTimeout(() => cta.setAttribute('data-settled', ''), 1500);
          obs.disconnect();
        }
      },
      { threshold: 0.3 },
    ).observe(cta);

    // Parallax del fondo + pausa de la franja fuera de pantalla
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      const r = cta.getBoundingClientRect();
      cta.style.setProperty('--p', Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height))).toFixed(4));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    new IntersectionObserver(
      ([entry]) => {
        cta.toggleAttribute('data-paused', !entry.isIntersecting);
        if (reduceMotion) return;
        if (entry.isIntersecting) {
          window.addEventListener('scroll', onScroll, { passive: true });
          update();
        } else {
          window.removeEventListener('scroll', onScroll);
        }
      },
      { rootMargin: '10% 0px' },
    ).observe(cta);
  }
</script>
