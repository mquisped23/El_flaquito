---
/**
 * Cierre de la página: franja con los productos desfilando y la "nota de
 * pedido". El visitante marca los productos que necesita (y su tipo de
 * negocio) y los envía por WhatsApp. Si antes eligió un negocio en
 * "¿Qué negocio vas a abastecer?", la nota llega ya rellenada.
 */
import { site } from '../config/site';
import { whatsappLink } from '../lib/whatsapp';
import { productos, nombreCompleto } from '../data/productos';
import { negocios } from '../data/negocios';
import Button from './ui/Button.astro';

const nombres = productos.map(nombreCompleto);
/** Datos que el script necesita para armar el mensaje. */
const datos = JSON.stringify(negocios.map((n) => ({ quien: n.quien, productos: n.productos })));
---

<section class="cta" aria-labelledby="cta-title" data-cta>
  <!-- Franja con los productos desfilando -->
  <div class="cta-marquee" aria-hidden="true">
    <div class="cta-track">
      {
        [0, 1].map(() => (
          <div class="cta-group">
            {nombres.map((nombre, k) => (
              <>
                <span class:list={['cta-word', { 'cta-word--outline': k % 2 === 1 }]}>{nombre}</span>
                <i class="fa-solid fa-star cta-star" />
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Cierre: texto + nota de pedido -->
  <div class="cta-main">
    <div class="cta-inner">
      <div class="cta-copy">
        <h2 id="cta-title" class="cta-title font-heading font-bold">
          <span class="cta-line"><span class="cta-line-in">Arma tu pedido</span></span>
          <span class="cta-line cta-line--gold"><span class="cta-line-in">y te lo cotizamos</span></span>
        </h2>

        <p class="cta-lead cta-rise" style="--i: 0">
          Marca lo que necesitas y envíalo por WhatsApp. Un asesor te responde con la lista de precios mayoristas y coordina
          la entrega con cadena de frío hasta tu local.
        </p>

        <div class="cta-more cta-rise" style="--i: 1">
          <Button
            href={encodeURI(site.catalogoPdf.href)}
            variant="gold"
            icon="fa-solid fa-file-pdf"
            trailingIcon="fa-solid fa-arrow-down"
            download
            sublabel={`PDF · ${site.catalogoPdf.peso}`}
            aria-label={`Descargar catálogo en PDF (${site.catalogoPdf.peso})`}
          >
            Descargar catálogo
          </Button>
          <a href={`tel:+${site.contact.whatsapp}`} class="cta-phone">
            <i class="fa-solid fa-phone" aria-hidden="true"></i>
            <span>o llámanos al <strong>{site.contact.phoneDisplay}</strong></span>
          </a>
        </div>
      </div>

      <!-- Nota de pedido -->
      <div class="tk-wrap">
        <div class="tk" data-ticket data-negocios={datos}>
          <div class="tk-head">
            <img src={site.logo} alt="" width="986" height="820" loading="lazy" decoding="async" class="tk-logo" />
            <div>
              <p class="tk-brand font-heading">Nota de pedido</p>
              <p class="tk-date" data-tk-date>Lima</p>
            </div>
          </div>

          <label class="tk-field">
            <span class="tk-field-label">Para mi</span>
            <span class="tk-select">
              <select data-tk-biz aria-label="Tipo de negocio">
                <option value="">negocio</option>
                {negocios.map((n, i) => <option value={i}>{n.boton === 'negocio' ? 'bodega / distribuidora' : n.boton}</option>)}
              </select>
              <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </span>
          </label>

          <fieldset class="tk-list">
            <legend class="sr-only">Productos que necesitas</legend>
            {
              productos.map((p, k) => (
                <label class="tk-row">
                  <input type="checkbox" class="tk-check" value={k} data-tk-item />
                  <span class="tk-box" aria-hidden="true">
                    <i class="fa-solid fa-check" />
                  </span>
                  <img src={encodeURI(p.imagen)} alt="" width="2048" height="2048" loading="lazy" decoding="async" class="tk-thumb" />
                  <span class="tk-name">{nombres[k]}</span>
                </label>
              ))
            }
          </fieldset>

          <div class="tk-foot">
            <p class="tk-count" aria-live="polite" data-tk-count>Marca los productos que necesitas</p>
            <Button
              href={whatsappLink(site.whatsappMessages.pedido('', []))}
              variant="primary"
              size="lg"
              icon="fa-brands fa-whatsapp"
              trailingIcon="fa-solid fa-arrow-right"
              external
              class="tk-send"
              data-tk-send
            >
              Cotizar por WhatsApp
            </Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    background: #0a0a0a;
  }

  /* ==================================================================
     Franja de productos
  ================================================================== */
  .cta-marquee {
    position: relative;
    z-index: 2;
    overflow: hidden;
    padding-block: 1.1rem;
    background: #0a0a0a;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .cta-track {
    display: flex;
    width: max-content;
    animation: marquee 34s linear infinite;
    will-change: transform;
  }

  .cta[data-paused] .cta-track {
    animation-play-state: paused;
  }

  .cta-group {
    display: flex;
    align-items: center;
    flex: none;
  }

  .cta-word {
    padding-inline: 1.25rem;
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.125rem, 1.9vw, 1.625rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1.1;
    white-space: nowrap;
    color: #f9fafb;
  }

  .cta-word--outline {
    color: transparent;
    -webkit-text-stroke: 1px var(--gold);
  }

  .cta-star {
    font-size: clamp(0.6rem, 0.9vw, 0.8rem);
    color: var(--red-hi);
  }

  @keyframes marquee {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* ==================================================================
     Cierre
  ================================================================== */
  .cta-main {
    position: relative;
    overflow: hidden;
    background: /* taste-skill-ignore: brasa y fundido al footer, igual que las demás secciones */
      radial-gradient(ellipse 42% 60% at 74% 55%, rgb(142 22 0 / 0.26), transparent 70%),
      linear-gradient(180deg, #0a0a0a 70%, #050505);
  }

  .cta-inner {
    display: grid;
    gap: 3.5rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 4.5rem 1rem 5.5rem;
  }

  @media (min-width: 640px) {
    .cta-inner {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .cta-inner {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: center;
      gap: 4rem;
      padding: 7rem 2rem 8rem;
    }
  }

  .cta-title {
    font-size: clamp(2.6rem, 5.6vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #f9fafb;
  }

  .cta-line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em 0.12em;
    margin-block: -0.06em -0.12em;
  }

  .cta-line-in {
    display: block;
    transition: transform 1.1s var(--ease-out);
  }

  .cta-line--gold .cta-line-in {
    color: var(--gold);
    font-style: italic;
    font-weight: 600;
    transition-delay: 0.15s;
  }

  .cta-lead {
    max-width: 32rem;
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    font-weight: 300;
    color: rgb(249 250 251 / 0.85);
  }

  @media (min-width: 1024px) {
    .cta-lead {
      font-size: 1.1875rem;
    }
  }

  .cta-more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }

  .cta-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9375rem;
    color: rgb(249 250 251 / 0.75);
    text-decoration: underline;
    text-decoration-color: rgb(197 160 89 / 0.4);
    text-underline-offset: 5px;
    transition:
      color 0.3s ease,
      text-decoration-color 0.3s ease;
  }

  .cta-phone i {
    color: var(--gold);
    font-size: 0.85rem;
  }

  .cta-phone strong {
    font-weight: 600;
    color: #f9fafb;
  }

  .cta-phone:hover {
    color: #f9fafb;
    text-decoration-color: var(--gold);
  }

  .cta-phone:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* ==================================================================
     Nota de pedido (papel)
  ================================================================== */
  .tk-wrap {
    display: flex;
    justify-content: center;
  }

  .tk {
    --ink: #24150d;
    --paper: #f4ecdf;
    position: relative;
    width: 100%;
    max-width: 27rem;
    padding: 1.5rem 1.5rem 2.25rem;
    background: var(--paper);
    color: var(--ink);
    transform: rotate(-1.5deg);
    box-shadow: /* taste-skill-ignore: el papel flota sobre el fondo */
      0 30px 60px -20px rgb(0 0 0 / 0.7),
      0 8px 16px -8px rgb(0 0 0 / 0.5);
    /* borde inferior dentado, como un ticket cortado */
    --tooth: 10px;
    mask: /* taste-skill-ignore: borde dentado del ticket, no es decoración */
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / calc(var(--tooth) * 2) var(--tooth)
        repeat-x,
      linear-gradient(#000 0 0) top / 100% calc(100% - var(--tooth) + 1px) no-repeat;
    transition: transform 0.6s var(--ease-out);
  }

  @media (hover: hover) {
    .tk:hover {
      transform: rotate(-0.5deg);
    }
  }

  @media (max-width: 1023px) {
    .tk {
      transform: rotate(-1deg);
    }
  }

  .tk-head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-bottom: 1rem;
    border-bottom: 2px dashed rgb(36 21 13 / 0.25);
  }

  .tk-logo {
    width: 3rem;
    height: auto;
  }

  .tk-brand {
    font-size: 1.375rem;
    font-weight: 700;
    font-style: italic;
    line-height: 1.1;
    color: var(--ink);
  }

  .tk-date {
    margin-top: 0.15rem;
    font-size: 0.875rem;
    color: rgb(36 21 13 / 0.65);
  }

  /* ---------- Para mi ... ---------- */
  .tk-field {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
    font-size: 1rem;
  }

  .tk-field-label {
    font-weight: 500;
    color: rgb(36 21 13 / 0.7);
  }

  .tk-select {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .tk-select select {
    appearance: none;
    padding: 0.2rem 1.6rem 0.2rem 0.1rem;
    border: 0;
    border-bottom: 2px solid #8e1600;
    border-radius: 0;
    background: transparent;
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 700;
    font-style: italic;
    color: #8e1600;
    cursor: pointer;
  }

  .tk-select select:focus-visible {
    outline: 2px solid #8e1600;
    outline-offset: 3px;
  }

  .tk-select i {
    position: absolute;
    right: 0.25rem;
    font-size: 0.75rem;
    color: #8e1600;
    pointer-events: none;
  }

  /* ---------- Productos ---------- */
  .tk-list {
    display: grid;
    gap: 0.25rem;
    margin: 1rem 0 0;
    padding: 0;
    border: 0;
  }

  .tk-row {
    position: relative;
    display: grid;
    grid-template-columns: 1.375rem 3rem minmax(0, 1fr);
    align-items: center;
    gap: 0.875rem;
    padding: 0.4rem 0.5rem;
    margin-inline: -0.5rem;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.25s ease;
  }

  .tk-row:hover {
    background: rgb(36 21 13 / 0.06);
  }

  .tk-check {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px; /* taste-skill-ignore: checkbox nativo oculto (accesible) */
  }

  .tk-box {
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    border: 2px solid rgb(36 21 13 / 0.35);
    border-radius: 3px;
    color: #fff;
    font-size: 0.7rem;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .tk-box i {
    opacity: 0;
    transform: scale(0.4) rotate(-20deg);
    transition:
      opacity 0.2s ease,
      transform 0.35s var(--ease-out);
  }

  .tk-check:checked + .tk-box {
    background: #8e1600;
    border-color: #8e1600;
  }

  .tk-check:checked + .tk-box i {
    opacity: 1;
    transform: none;
  }

  .tk-check:focus-visible + .tk-box {
    outline: 2px solid #8e1600;
    outline-offset: 3px;
  }

  .tk-thumb {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
  }

  .tk-name {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .tk-check:checked ~ .tk-name {
    font-weight: 700;
  }

  /* ---------- Pie ---------- */
  .tk-foot {
    margin-top: 1rem;
    padding-top: 1.1rem;
    border-top: 2px dashed rgb(36 21 13 / 0.25);
  }

  .tk-count {
    margin-bottom: 0.9rem;
    font-size: 0.9375rem;
    color: rgb(36 21 13 / 0.75);
  }

  .tk-count strong {
    font-weight: 700;
    color: var(--ink);
  }

  .tk-foot :global(.tk-send) {
    width: 100%;
  }

  .tk-foot :global(.tk-send .btn-trail) {
    margin-left: auto;
  }

  :global(html:not(.js)) .tk-count {
    display: none;
  }

  /* ==================================================================
     Entrada
  ================================================================== */
  :global(html.js) .cta:not([data-in]) .cta-line-in {
    transform: translateY(105%) rotate(2deg);
  }

  :global(html.js) .cta:not([data-in]) .cta-rise {
    opacity: 0;
    transform: translateY(20px);
  }

  /* La nota "sale" de abajo y se acomoda inclinada */
  :global(html.js) .cta:not([data-in]) .tk {
    opacity: 0;
    transform: translateY(60px) rotate(-7deg);
  }

  :global(html.js) .cta:not([data-settled]) .tk {
    transition:
      opacity 0.7s var(--ease-out) 0.35s,
      transform 1.1s var(--ease-out) 0.35s;
  }

  .cta-rise {
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.9s var(--ease-out);
    transition-delay: calc(0.4s + var(--i, 0) * 0.1s);
  }

  :global(html.js) .cta[data-settled] .cta-rise {
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-track {
      animation: none;
    }

    .cta-line-in,
    .cta-rise,
    .tk,
    .tk-box i {
      transition: none !important;
    }

    :global(html.js) .cta .cta-line-in,
    :global(html.js) .cta .cta-rise {
      transform: none !important;
      opacity: 1 !important;
    }

    :global(html.js) .cta .tk {
      opacity: 1 !important;
      transform: rotate(-1.5deg) !important;
    }
  }
</style>

<script>
  import { site } from '../config/site';
  import { whatsappLink } from '../lib/whatsapp';
  import { productos, nombreCompleto } from '../data/productos';

  const cta = document.querySelector<HTMLElement>('[data-cta]');

  if (cta) {
    // Entrada (una vez)
    new IntersectionObserver(
      (entries, obs) => {
        if (entries.some((e) => e.isIntersecting)) {
          cta.setAttribute('data-in', '');
          setTimeout(() => cta.setAttribute('data-settled', ''), 1600);
          obs.disconnect();
        }
      },
      { threshold: 0.25 },
    ).observe(cta);

    // Pausa la franja cuando no se ve
    new IntersectionObserver(([entry]) => cta.toggleAttribute('data-paused', !entry.isIntersecting), {
      rootMargin: '10% 0px',
    }).observe(cta);
  }

  // ---------- Nota de pedido ----------
  const tk = document.querySelector<HTMLElement>('[data-ticket]');
  if (tk) {
    const negocios: { quien: string; productos: number[] }[] = JSON.parse(tk.dataset.negocios || '[]');
    const biz = tk.querySelector<HTMLSelectElement>('[data-tk-biz]')!;
    const items = Array.from(tk.querySelectorAll<HTMLInputElement>('[data-tk-item]'));
    const count = tk.querySelector<HTMLElement>('[data-tk-count]')!;
    const send = tk.querySelector<HTMLAnchorElement>('[data-tk-send]')!;
    const fecha = tk.querySelector<HTMLElement>('[data-tk-date]');

    if (fecha) {
      fecha.textContent = `Lima, ${new Intl.DateTimeFormat('es-PE', { day: 'numeric', month: 'long' }).format(new Date())}`;
    }

    const update = () => {
      const marcados = items.filter((i) => i.checked).map((i) => nombreCompleto(productos[Number(i.value)]));
      const n = biz.value === '' ? null : negocios[Number(biz.value)];
      send.href = whatsappLink(site.whatsappMessages.pedido(n ? n.quien : '', marcados));
      count.innerHTML = marcados.length
        ? `<strong>${marcados.length}</strong> ${marcados.length === 1 ? 'producto marcado' : 'productos marcados'}`
        : 'Marca los productos que necesitas';
    };

    // Elegir el negocio marca sus productos recomendados
    const aplicarNegocio = (i: number) => {
      biz.value = String(i);
      const recomendados = negocios[i]?.productos ?? [];
      items.forEach((it) => (it.checked = recomendados.includes(Number(it.value))));
      update();
    };

    biz.addEventListener('change', () => {
      if (biz.value !== '') aplicarNegocio(Number(biz.value));
      else update();
    });
    items.forEach((it) => it.addEventListener('change', update));

    // Lo que el visitante eligió en "¿Qué negocio vas a abastecer?"
    document.addEventListener('biz:select', (e) => aplicarNegocio((e as CustomEvent<number>).detail));

    update();
  }
</script>
