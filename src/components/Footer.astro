---
/**
 * Pie de página: marca, enlaces, contacto y barra inferior.
 * Los datos se editan en src/config/site.ts
 */
import { site } from '../config/site';
import { whatsappLink } from '../lib/whatsapp';

const year = new Date().getFullYear();
const mapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.contact.address + ', Lima, Perú')}`;
---

<footer class="foot" data-foot>
  <div class="foot-inner">
    <div class="foot-grid">
      <!-- Marca -->
      <div class="foot-brand">
        <a href="#inicio" class="foot-logo" aria-label={`${site.name}, volver al inicio`}>
          <img src={site.logo} alt="" width="986" height="820" loading="lazy" decoding="async" />
        </a>
        <p class="foot-about">
          Distribución mayorista de carnes y embutidos para el sector gastronómico. Calidad premium garantizada en cada
          corte.
        </p>
        <ul class="foot-social">
          {
            site.social.map((red) => (
              <li>
                <a
                  href={red.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${red.name} de ${site.name}`}
                  class="foot-social-link"
                >
                  <i class={red.icon} aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Explorar -->
      <nav class="foot-col" aria-label="Pie de página">
        <h2 class="foot-title font-heading">Explorar</h2>
        <ul class="foot-links">
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} class="foot-link">
                  {item.footerLabel}
                </a>
              </li>
            ))
          }
          <li>
            <a href={encodeURI(site.catalogoPdf.href)} class="foot-link" download>
              Catálogo en PDF <span class="foot-meta">{site.catalogoPdf.peso}</span>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Contacto -->
      <div class="foot-col foot-col--contact">
        <h2 class="foot-title font-heading">Contáctanos</h2>
        <ul class="foot-contact">
          <li>
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
            <a href={whatsappLink(site.whatsappMessages.general)} target="_blank" rel="noopener noreferrer" class="foot-link">
              {site.contact.phoneDisplay}
            </a>
          </li>
          <li>
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
            <a href={`mailto:${site.contact.email}`} class="foot-link foot-link--break">{site.contact.email}</a>
          </li>
          <li>
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <a href={mapa} target="_blank" rel="noopener noreferrer" class="foot-link foot-address">
              {site.contact.address}
              <span class="foot-meta">Ver en el mapa <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="foot-bar">
      <p>&copy; {year} {site.name} · <span class="foot-slogan">{site.slogan}</span></p>
      <p>Atención exclusiva para negocios <strong>B2B</strong></p>
      <a href="#inicio" class="foot-top">
        Volver arriba <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 50% at 50% 100%, rgb(142 22 0 / 0.22), transparent 70%),
      #050505;
    color: #9ca3af;
  }

  .foot-inner {
    max-width: 80rem;
    margin-inline: auto;
    padding: 4.5rem 1rem 2.5rem;
  }

  @media (min-width: 640px) {
    .foot-inner {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .foot-inner {
      padding: 6rem 2rem 3rem;
    }
  }

  /* ---------- Columnas ---------- */
  .foot-grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .foot-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .foot-brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .foot-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 3fr) minmax(0, 4fr);
      gap: 4rem;
    }

    .foot-brand {
      grid-column: auto;
    }
  }

  .foot-logo {
    display: inline-block;
    border-radius: 4px;
    transition: transform 0.5s var(--ease-out);
  }

  .foot-logo img {
    width: auto;
    height: 4.5rem;
  }

  .foot-logo:hover {
    transform: rotate(-4deg) scale(1.04);
  }

  .foot-logo:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  .foot-about {
    max-width: 24rem;
    margin-top: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    font-weight: 300;
  }

  .foot-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .foot-social-link {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.05);
    color: #f9fafb;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      transform 0.4s var(--ease-out);
  }

  .foot-social-link:hover {
    background: var(--gold);
    color: #0a0a0a;
    transform: translateY(-3px);
  }

  .foot-social-link:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  .foot-title {
    font-size: 1.5rem;
    font-weight: 700;
    font-style: italic;
    color: var(--gold);
  }

  .foot-links,
  .foot-contact {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  .foot-link {
    font-size: 0.9375rem;
    color: rgb(249 250 251 / 0.8);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition:
      color 0.3s ease,
      text-decoration-color 0.3s ease;
  }

  .foot-link:hover {
    color: #f9fafb;
    text-decoration-color: var(--gold);
  }

  .foot-link:focus-visible,
  .foot-top:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .foot-link--break {
    overflow-wrap: anywhere;
  }

  .foot-meta {
    margin-left: 0.4rem;
    font-size: 0.8125rem;
    color: #9ca3af;
  }

  .foot-contact li {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
  }

  .foot-contact i {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: var(--gold);
  }

  .foot-address {
    text-transform: capitalize;
    line-height: 1.6;
  }

  .foot-address .foot-meta {
    display: block;
    margin: 0.35rem 0 0;
    text-transform: none;
  }

  .foot-address .foot-meta i {
    margin: 0 0 0 0.25rem;
    font-size: 0.7rem;
    color: inherit;
  }

  /* ---------- Barra inferior ---------- */
  .foot-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 4rem;
    font-size: 0.8125rem;
    color: rgb(156 163 175 / 0.8);
  }

  .foot-slogan {
    color: var(--gold);
  }

  .foot-bar strong {
    font-weight: 600;
    color: var(--gold);
  }

  .foot-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: #f9fafb;
    transition: color 0.3s ease;
  }

  .foot-top i {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--red);
    color: #f9fafb;
    transition: transform 0.4s var(--ease-out);
  }

  .foot-top:hover {
    color: var(--gold);
  }

  .foot-top:hover i {
    transform: translateY(-4px);
  }
</style>
