---
/**
 * Botón flotante de WhatsApp (esquina inferior derecha).
 */
import { site } from '../config/site';
import { whatsappLink } from '../lib/whatsapp';
---

<a
  href={whatsappLink(site.whatsappMessages.flotante)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
  class="fixed bottom-6 right-6 z-50 bg-brand-gold text-brand-black w-14 h-14 md:w-16 md:h-16 rounded-full flex items-center justify-center text-3xl shadow-[0_4px_20px_rgba(197,160,89,0.4)] hover:scale-110 hover:bg-brand-goldHover transition-all duration-300 cursor-pointer group border border-brand-goldHover"
>
  <i class="fa-brands fa-whatsapp group-hover:animate-pulse"></i>
</a>
