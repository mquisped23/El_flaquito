---
/**
 * Sección "Nuestro Catálogo" con pestañas por categoría.
 * Las categorías y productos se editan en src/data/productos.ts
 */
import { categorias } from '../../data/productos';
import { site } from '../../config/site';
import { whatsappLink } from '../../lib/whatsapp';
import ProductCard from './ProductCard.astro';

const tabBase =
  'tab-btn w-64 sm:w-auto px-6 py-3 md:px-8 rounded-sm font-semibold uppercase tracking-widest text-xs md:text-sm transition-all border';
const tabActive = 'active border-brand-red bg-brand-red text-white shadow-[0_0_15px_rgba(142,22,0,0.4)]';
const tabInactive = 'border-white/20 text-brand-gray hover:border-brand-gold hover:text-brand-gold bg-transparent';
---

<section id="catalogo" class="pt-8 pb-16 md:pt-12 md:pb-24 bg-brand-black relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 md:mb-16" data-aos="fade-up">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold uppercase mb-4 tracking-wide">
        Nuestro <span class="text-brand-red">Catálogo</span>
      </h2>
      <div class="w-24 h-1 bg-brand-gold mx-auto mb-6"></div>
      <p class="text-brand-gray max-w-2xl mx-auto text-base md:text-lg font-light">
        Selecciona una categoría para explorar nuestra oferta de productos diseñados para maximizar la rentabilidad de
        tu negocio.
      </p>
    </div>

    <div
      class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 md:gap-4 mb-12 md:mb-16"
      role="tablist"
      aria-label="Categorías del catálogo"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      {
        categorias.map((cat, i) => (
          <button
            type="button"
            role="tab"
            class={`${tabBase} ${i === 0 ? tabActive : tabInactive}`}
            data-target={cat.id}
            aria-controls={cat.id}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <i class={`${cat.icono} mr-2 w-4`} /> {cat.nombre}
          </button>
        ))
      }
    </div>

    {
      categorias.map((cat, i) => (
        <div id={cat.id} role="tabpanel" class:list={['tab-content', { active: i === 0 }]}>
          <div class="flex md:grid flex-nowrap overflow-x-auto md:overflow-visible snap-x snap-mandatory gap-6 md:gap-8 pb-8 md:pb-0 no-scrollbar md:grid-cols-2 lg:grid-cols-3">
            {cat.productos.map((producto, j) => (
              // Solo se anima la pestaña visible al cargar: AOS no calcula bien
              // la posición de elementos ocultos (display: none).
              <ProductCard producto={producto} aosDelay={i === 0 ? (j + 1) * 100 : undefined} />
            ))}
          </div>
        </div>
      ))
    }

    <div class="text-center mt-12" data-aos="zoom-in">
      <a
        href={whatsappLink(site.whatsappMessages.catalogoPdf)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-brand-gold hover:text-white font-semibold transition-colors uppercase tracking-widest text-sm pb-1 border-b border-brand-gold hover:border-white"
      >
        Solicitar Catálogo Completo PDF <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

<script>
  // Pestañas (tabs) del catálogo
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const tabContents = document.querySelectorAll<HTMLElement>('.tab-content');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabBtns.forEach((b) => {
        b.classList.remove('active', 'border-brand-red', 'bg-brand-red', 'text-white', 'shadow-[0_0_15px_rgba(142,22,0,0.4)]');
        b.classList.add('border-white/20', 'text-brand-gray', 'bg-transparent');
        b.setAttribute('aria-selected', 'false');
      });

      btn.classList.add('active', 'border-brand-red', 'bg-brand-red', 'text-white', 'shadow-[0_0_15px_rgba(142,22,0,0.4)]');
      btn.classList.remove('border-white/20', 'text-brand-gray', 'bg-transparent');
      btn.setAttribute('aria-selected', 'true');

      tabContents.forEach((content) => content.classList.remove('active'));
      const target = btn.dataset.target;
      if (target) document.getElementById(target)?.classList.add('active');
    });
  });
</script>
