---
/**
 * Sección "Catálogo": un producto a la vez sobre una rueda.
 *
 * - Con JS: la sección queda fijada (sticky) mientras se hace scroll; cada paso
 *   de la rueda del mouse (o cada tramo de scroll en móvil) gira la rueda al
 *   siguiente producto. Al terminar el último, la página sigue bajando.
 * - Sin JS: los productos se muestran uno debajo de otro.
 *
 * Los productos se editan en src/data/productos.ts
 */
import { productos, nombreCompleto } from '../../data/productos';
import { site } from '../../config/site';
import { whatsappLink } from '../../lib/whatsapp';
import Button from '../ui/Button.astro';

/** Grados que gira la rueda entre un producto y el siguiente. */
const ANGLE = 44;

const pad = (n: number) => String(n).padStart(2, '0');

// Posición de cada producto sobre el anillo decorativo (SVG 200x200, radio 99).
// El producto activo siempre queda en el punto izquierdo del anillo (180°).
const dots = productos.map((_, k) => {
  const rad = ((180 - k * ANGLE) * Math.PI) / 180;
  return { cx: 100 + 99 * Math.cos(rad), cy: 100 + 99 * Math.sin(rad) };
});
---

<section
  id="catalogo"
  class="cat relative bg-brand-black"
  style={`--n: ${productos.length}; --angle: ${ANGLE}deg; --active: 0;`}
  aria-labelledby="catalogo-titulo"
  data-catalogo
>
  <h2 id="catalogo-titulo" class="sr-only">Nuestro catálogo</h2>

  <div class="cat-stage">
    <!-- Fondo: textura + luz cálida -->
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute inset-0 bg-texture opacity-[0.12] mix-blend-overlay"></div>
      <div class="cat-vignette absolute inset-0"></div>
    </div>

    <!-- Rueda decorativa (comparte la geometría de las diapositivas) -->
    <div class="cat-slide cat-ringlayer" aria-hidden="true">
      <div class="cat-copy"></div>
      <div class="cat-media">
        <div class="cat-figure">
          <div class="cat-glow"></div>
          <div class="cat-ring">
            <svg viewBox="0 0 200 200" fill="none">
              <circle cx="100" cy="100" r="99" stroke="currentColor" stroke-width="0.25" opacity="0.35"></circle>
              <circle cx="100" cy="100" r="93" stroke="currentColor" stroke-width="0.6" stroke-dasharray="0.4 2.2" opacity="0.4"></circle>
              {
                dots.map((d, k) => (
                  <circle class="cat-dot" data-dot={k} cx={d.cx.toFixed(2)} cy={d.cy.toFixed(2)} r="1.1" fill="currentColor" />
                ))
              }
            </svg>
          </div>
          <div class="cat-floor"></div>
        </div>
      </div>
    </div>

    <!-- Diapositivas -->
    {
      productos.map((p, i) => {
        const nombre = nombreCompleto(p);
        return (
          <article
            class="cat-slide"
            data-slide
            data-state={i === 0 ? 'active' : 'next'}
            aria-roledescription="producto"
            aria-label={`${nombre}, ${i + 1} de ${productos.length}`}
          >
            <div class="cat-copy">
              <h3 class="cat-name font-heading font-bold text-brand-white" style="--i: 0">
                {p.nombre}
                {p.detalle && <span class="block font-normal italic text-brand-gold">{p.detalle}</span>}
              </h3>

              <p class="cat-desc mt-5 md:mt-7 text-base md:text-lg text-brand-gray font-light leading-relaxed" style="--i: 1">
                {p.descripcion}
              </p>

              <ul class="cat-benefits mt-6 space-y-2.5" style="--i: 2">
                {p.beneficios.map((b) => (
                  <li class="flex items-start gap-3 text-sm text-brand-white/75 font-light">
                    <i class="fa-solid fa-check text-brand-gold text-xs mt-1.5" aria-hidden="true" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>

              <div class="cat-actions mt-8 md:mt-10 flex flex-wrap items-stretch gap-3 sm:gap-4" style="--i: 3">
                <dl class="cat-pres flex items-stretch border border-brand-gold/35 rounded-sm bg-brand-black/40 backdrop-blur-sm">
                  {p.presentacion.map((item, k) => (
                    <div class:list={['flex items-center gap-2.5 px-4 py-3 sm:px-5', { 'border-l border-brand-gold/20': k > 0 }]}>
                      <dt class="sr-only">Presentación</dt>
                      <i class={`${item.icono} text-brand-gold text-sm`} aria-hidden="true" />
                      <dd class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-brand-white whitespace-nowrap">
                        {item.texto}
                      </dd>
                    </div>
                  ))}
                </dl>

                <Button
                  href={whatsappLink(site.whatsappMessages.producto(nombre))}
                  variant="primary"
                  icon="fa-brands fa-whatsapp"
                  trailingIcon="fa-solid fa-arrow-right"
                  external
                  class="cat-cta"
                  aria-label={`Consultar precio de ${nombre} por WhatsApp`}
                >
                  Consultar precio
                </Button>
              </div>
            </div>

            <div class="cat-media">
              <div class="cat-figure">
                <img
                  class="cat-img"
                  src={encodeURI(p.imagen)}
                  alt={p.imagenAlt}
                  width="2048"
                  height="2048"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
            </div>
          </article>
        );
      })
    }

    <!-- Riel de progreso / navegación -->
    <nav class="cat-rail" aria-label="Productos del catálogo">
      <p class="cat-count font-heading text-brand-white/50 text-sm tabular-nums lg:hidden" aria-hidden="true">
        <span class="text-brand-gold" data-count>01</span> / {pad(productos.length)}
      </p>
      <ol class="flex flex-1 gap-2 lg:gap-6">
        {
          productos.map((p, i) => (
            <li class="flex-1">
              <button
                type="button"
                class="cat-rail-btn group w-full text-left pt-3 pb-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold rounded-sm"
                data-goto={i}
                aria-current={i === 0 ? 'step' : 'false'}
              >
                <span class="cat-rail-bar block h-px w-full" />
                <span class="mt-3 hidden lg:flex items-baseline gap-2 text-xs uppercase tracking-widest">
                  <span class="cat-rail-num font-heading tabular-nums">{pad(i + 1)}</span>
                  <span class="cat-rail-label truncate">{nombreCompleto(p)}</span>
                </span>
                <span class="sr-only lg:hidden">{nombreCompleto(p)}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </nav>

    <p class="sr-only" aria-live="polite" data-live></p>
  </div>
</section>

<style>
  /* ------------------------------------------------------------------
     Geometría
     --fig: tamaño de la imagen   --r: radio de la rueda (eje a la derecha)
  ------------------------------------------------------------------ */
  .cat {
    --fig: min(78vw, 34svh);
    --r: calc(var(--fig) * 1.2);
    --ease-wheel: cubic-bezier(0.76, 0, 0.24, 1);
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --step: 70svh;
  }

  @media (min-width: 1024px) {
    .cat {
      --fig: min(42vw, 64svh, 40rem);
      --step: 85svh;
    }
  }

  .cat-stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .cat-vignette {
    background:
      radial-gradient(ellipse 60% 70% at 72% 52%, rgb(142 22 0 / 0.16), transparent 70%),
      radial-gradient(ellipse 90% 80% at 50% 50%, transparent 40%, rgb(0 0 0 / 0.65) 100%);
  }

  /* ---------- Diapositiva (sin JS: apiladas) ---------- */
  .cat-slide {
    display: grid;
    /* fila de imagen con alto fijo: así la capa del anillo y las diapositivas coinciden */
    grid-template-rows: var(--fig) auto;
    align-content: start;
    gap: 2rem;
    width: 100%;
    max-width: 80rem;
    min-height: 100svh;
    margin-inline: auto;
    padding: 6.5rem 1rem 6rem;
  }

  .cat-media {
    grid-row: 1;
    display: grid;
    place-items: center;
  }

  .cat-copy {
    grid-row: 2;
    max-width: 36rem;
  }

  @media (min-width: 640px) {
    .cat-slide {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .cat-slide {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: none;
      align-content: center;
      align-items: center;
      gap: 4rem;
      padding: 7rem 2rem 7.5rem;
    }

    .cat-media,
    .cat-copy {
      grid-row: 1;
    }
  }

  .cat-figure {
    position: relative;
    width: var(--fig);
    aspect-ratio: 1;
  }

  .cat-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Sin filter: drop-shadow — se recalculaba en cada frame mientras la imagen gira.
       La sombra la pone .cat-floor (degradado estático). */
  }

  /* ---------- Tipografía ---------- */
  .cat-name {
    font-size: clamp(2.5rem, 9vw, 3.25rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .cat-name {
      font-size: clamp(3rem, 5.2vw, 5.5rem);
    }
  }

  .cat-desc {
    max-width: 44ch;
  }

  /* Celulares de poca altura (ej. 360x640): todo más compacto para que entre sobre el riel */
  @media (max-width: 1023px) and (max-height: 720px) {
    .cat {
      --fig: min(66vw, 27svh);
    }

    .cat-slide {
      gap: 1.25rem;
      padding-top: 5.75rem;
    }

    .cat-name {
      font-size: 2.25rem;
    }

    .cat-desc {
      margin-top: 0.75rem;
      font-size: 0.9375rem;
      line-height: 1.55;
    }

    .cat-actions {
      margin-top: 1.25rem;
    }
  }

  @media (max-width: 1023px) {
    :global(.cat-cta) {
      flex: 1 1 100%;
    }

    :global(.cat-cta .btn-trail) {
      margin-left: auto;
    }
  }

  /* Beneficios: solo en escritorio con altura suficiente */
  .cat-benefits {
    display: none;
  }

  @media (min-width: 1024px) and (min-height: 760px) {
    .cat-benefits {
      display: block;
    }
  }

  /* ---------- Rueda decorativa ---------- */
  .cat-ringlayer,
  .cat-rail {
    display: none;
  }

  .cat-glow {
    position: absolute;
    inset: -30%;
    background:
      radial-gradient(circle at 50% 55%, rgb(197 160 89 / 0.16), transparent 42%),
      radial-gradient(circle at 50% 60%, rgb(142 22 0 / 0.38), transparent 62%);
  }

  .cat-floor {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 0;
    height: 15%;
    border-radius: 50%;
    background: radial-gradient(closest-side at center, rgb(0 0 0 / 0.85), rgb(0 0 0 / 0.4) 55%, transparent);
  }

  .cat-ring {
    position: absolute;
    left: 50%;
    top: calc(50% - var(--r));
    width: calc(var(--r) * 2);
    height: calc(var(--r) * 2);
    color: #c5a059;
    transform: rotate(calc(var(--active) * var(--angle)));
    transition: transform 1.1s var(--ease-wheel);
  }

  .cat-ring svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .cat-dot {
    opacity: 0.35;
    transition: opacity 0.4s ease;
  }

  .cat-dot.is-active {
    opacity: 1;
  }

  /* ==================================================================
     Modo interactivo (con JS)
  ================================================================== */
  :global(html.js) .cat {
    height: calc(100svh + (var(--n) - 1) * var(--step));
  }

  :global(html.js) .cat-stage {
    position: sticky;
    top: 0;
    height: 100svh;
  }

  :global(html.js) .cat-slide {
    position: absolute;
    inset: 0;
    min-height: 0;
  }

  :global(html.js) .cat-ringlayer {
    display: grid;
    z-index: 0;
  }

  :global(html.js) [data-slide] {
    z-index: 1;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 1.1s;
  }

  :global(html.js) [data-slide][data-state='active'] {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  /* Imagen sobre la rueda: el eje está a la derecha de la imagen */
  :global(html.js) .cat-img {
    transform-origin: calc(50% + var(--r)) 50%;
    /* la imagen saliente se ve rodar y se apaga en la segunda mitad del giro */
    transition:
      transform 1.1s var(--ease-wheel),
      opacity 0.45s ease 0.4s;
  }

  :global(html.js) [data-state='next'] .cat-img {
    opacity: 0;
    transform: rotate(calc(var(--angle) * -1)) scale(0.82);
  }

  :global(html.js) [data-state='past'] .cat-img {
    opacity: 0;
    transform: rotate(var(--angle)) scale(0.82);
  }

  :global(html.js) [data-state='active'] .cat-img {
    opacity: 1;
    transform: none;
    transition:
      transform 1.1s var(--ease-wheel),
      opacity 0.5s ease 0.1s;
  }

  /* Texto: sale rápido, entra en cascada (desenfocado → nítido) */
  :global(html.js) .cat-copy > * {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  :global(html.js) [data-state='past'] .cat-copy > * {
    transform: translateY(-18px);
  }

  :global(html.js) [data-state='active'] .cat-copy > * {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.7s var(--ease-out) calc(0.35s + var(--i, 0) * 0.08s),
      transform 0.9s var(--ease-out) calc(0.35s + var(--i, 0) * 0.08s);
  }

  /* ---------- Riel ---------- */
  :global(html.js) .cat-rail {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 0 6rem 1.25rem 1rem;
  }

  @media (min-width: 640px) {
    :global(html.js) .cat-rail {
      padding-left: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    :global(html.js) .cat-rail {
      /* a la derecha deja libre el botón flotante de WhatsApp (~6.5rem desde el borde) */
      padding: 0 max(2rem, calc(6.5rem - (100vw - 80rem) / 2)) 1.75rem 2rem;
    }
  }

  .cat-rail-bar {
    background: rgb(255 255 255 / 0.14);
    transition: background-color 0.4s ease;
  }

  .cat-rail-num,
  .cat-rail-label {
    color: rgb(156 163 175 / 0.85);
    transition: color 0.3s ease;
  }

  .cat-rail-btn:hover .cat-rail-bar {
    background: rgb(197 160 89 / 0.5);
  }

  .cat-rail-btn:hover .cat-rail-label {
    color: #f9fafb;
  }

  .cat-rail-btn[aria-current='step'] .cat-rail-bar {
    background: #c5a059;
  }

  .cat-rail-btn[aria-current='step'] .cat-rail-num {
    color: #c5a059;
  }

  .cat-rail-btn[aria-current='step'] .cat-rail-label {
    color: #f9fafb;
  }

  /* ---------- Movimiento reducido: solo fundidos ---------- */
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .cat-img,
    :global(html.js) [data-state] .cat-img {
      transform: none !important;
      transition: opacity 0.4s ease !important;
    }

    :global(html.js) .cat-copy > * {
      transform: none !important;
      filter: none !important;
    }

    .cat-ring {
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-catalogo]');

  if (section) {
    const slides = Array.from(section.querySelectorAll<HTMLElement>('[data-slide]'));
    const railBtns = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-goto]'));
    const dots = Array.from(section.querySelectorAll<SVGElement>('[data-dot]'));
    const count = section.querySelector<HTMLElement>('[data-count]');
    const live = section.querySelector<HTMLElement>('[data-live]');
    const n = slides.length;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let active = -1;

    /** Marca el producto activo; el CSS se encarga de la animación. */
    const setActive = (index: number, announce = false) => {
      const i = Math.max(0, Math.min(n - 1, index));
      if (i === active) return;
      active = i;

      slides.forEach((slide, k) => {
        slide.dataset.state = k < i ? 'past' : k > i ? 'next' : 'active';
        slide.inert = k !== i;
      });
      railBtns.forEach((btn, k) => btn.setAttribute('aria-current', k === i ? 'step' : 'false'));
      dots.forEach((dot, k) => dot.classList.toggle('is-active', k === i));
      section.style.setProperty('--active', String(i));
      if (count) count.textContent = String(i + 1).padStart(2, '0');
      if (announce && live) live.textContent = slides[i].getAttribute('aria-label') ?? '';
    };

    // ---------- Medidas ----------
    const metrics = () => {
      const top = section.getBoundingClientRect().top + window.scrollY;
      const range = Math.max(1, section.offsetHeight - window.innerHeight);
      return { top, range, step: range / (n - 1) };
    };

    const indexFromScroll = () => {
      const { top, range } = metrics();
      const progress = Math.min(1, Math.max(0, (window.scrollY - top) / range));
      return Math.round(progress * (n - 1));
    };

    /** true mientras la sección está fijada en pantalla. */
    const isPinned = () => {
      const r = section.getBoundingClientRect();
      return r.top <= 1 && r.bottom >= window.innerHeight - 1;
    };

    // ---------- Ir a un producto ----------
    let targetY: number | null = null;
    let targetUntil = 0;

    const goTo = (index: number) => {
      const i = Math.max(0, Math.min(n - 1, index));
      const { top, step } = metrics();
      targetY = Math.round(top + i * step);
      targetUntil = performance.now() + 1500;
      setActive(i, true);
      window.scrollTo({ top: targetY, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    };

    // ---------- Scroll (touch, teclado, barra) ----------
    let snapTimer: ReturnType<typeof setTimeout> | undefined;
    let touching = false;

    const snapToNearest = () => {
      if (touching || targetY !== null || !isPinned()) return;
      const { top, step } = metrics();
      const i = indexFromScroll();
      if (Math.abs(window.scrollY - (top + i * step)) > 2) goTo(i);
    };

    const onScroll = () => {
      if (targetY !== null) {
        // Durante un desplazamiento automático no recalculamos el índice
        if (Math.abs(window.scrollY - targetY) <= 2 || performance.now() > targetUntil) targetY = null;
        else return;
      }
      setActive(indexFromScroll());
      clearTimeout(snapTimer);
      snapTimer = setTimeout(snapToNearest, 180);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('touchstart', () => (touching = true), { passive: true });
    window.addEventListener(
      'touchend',
      () => {
        touching = false;
        clearTimeout(snapTimer);
        snapTimer = setTimeout(snapToNearest, 180);
      },
      { passive: true },
    );

    // ---------- Rueda del mouse / touchpad: un gesto = un producto ----------
    let gestureBusy = false;
    let busyUntil = 0;
    let idleTimer: ReturnType<typeof setTimeout> | undefined;
    let wasPinned = false;

    const releaseWhenIdle = () => {
      clearTimeout(idleTimer);
      const wait = () => {
        const left = busyUntil - performance.now();
        if (left > 0) idleTimer = setTimeout(wait, left);
        else gestureBusy = false;
      };
      idleTimer = setTimeout(wait, 200); // fin de la inercia del touchpad
    };

    window.addEventListener(
      'wheel',
      (e) => {
        const pinned = isPinned();
        const entering = pinned && !wasPinned;
        wasPinned = pinned;

        if (!pinned || e.ctrlKey || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
        const dir = Math.sign(e.deltaY);
        if (!dir) return;

        // Al entrar a la sección, el gesto en curso solo la "asienta" en el primer/último producto
        if (entering) {
          e.preventDefault();
          gestureBusy = true;
          busyUntil = performance.now() + 500;
          goTo(dir > 0 ? 0 : n - 1);
          releaseWhenIdle();
          return;
        }

        // En los extremos, un gesto nuevo deja que la página siga su curso
        if (!gestureBusy && ((dir > 0 && active === n - 1) || (dir < 0 && active === 0))) return;

        e.preventDefault();
        releaseWhenIdle();
        if (gestureBusy) return;

        gestureBusy = true;
        busyUntil = performance.now() + 750;
        goTo(active + dir);
      },
      { passive: false },
    );

    // ---------- Riel ----------
    railBtns.forEach((btn) => btn.addEventListener('click', () => goTo(Number(btn.dataset.goto))));

    // Estado inicial (por si la página carga con scroll a mitad de la sección)
    setActive(indexFromScroll());
    wasPinned = isPinned();
  }
</script>
