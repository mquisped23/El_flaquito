---
/**
 * Tarjeta de producto del catálogo.
 * Los datos vienen de src/data/productos.ts
 */
import type { Producto } from '../../data/productos';
import { whatsappLink } from '../../lib/whatsapp';

interface Props {
  producto: Producto;
  /** Retraso de la animación de entrada (ms). Si no se indica, la tarjeta no se anima. */
  aosDelay?: number;
}

const { producto, aosDelay } = Astro.props;

const badgeClasses = {
  gold: 'text-brand-gold border-brand-gold/30',
  light: 'text-brand-white border-white/30',
};

const aosAttrs = aosDelay !== undefined ? { 'data-aos': 'fade-up', 'data-aos-delay': String(aosDelay) } : {};
---

<div
  class="w-[85vw] shrink-0 snap-center md:w-auto bg-brand-dark rounded-sm overflow-hidden border border-white/5 hover:border-brand-gold/30 transition-all duration-300 group relative flex flex-col"
  {...aosAttrs}
>
  <div
    class="h-56 md:h-64 relative flex justify-center items-center p-6 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-[#2a2a2a] to-brand-dark"
  >
    <img
      src={producto.imagen}
      alt={producto.imagenAlt}
      loading="lazy"
      decoding="async"
      class="w-3/4 h-3/4 object-contain drop-shadow-[0_20px_20px_rgba(0,0,0,0.8)] transform group-hover:scale-110 group-hover:-translate-y-2 transition-all duration-500 ease-out"
    />
    {
      producto.badge && (
        <div
          class:list={[
            'absolute top-4 right-4 bg-brand-black/90 backdrop-blur text-[10px] font-bold px-3 py-1 rounded-sm uppercase tracking-widest border z-20 shadow-md',
            badgeClasses[producto.badge.variante],
          ]}
        >
          {producto.badge.texto}
        </div>
      )
    }
  </div>
  <div class="p-6 relative flex flex-col flex-grow bg-brand-dark">
    <h3 class="text-2xl font-heading font-bold mb-2 group-hover:text-brand-red transition-colors tracking-wide">
      {producto.nombre}
    </h3>
    <p class="text-gray-300 text-sm mb-4 line-clamp-2 font-light flex-grow">{producto.descripcion}</p>
    <div class="flex justify-between items-center border-t border-white/10 pt-4 mb-5">
      <span class="text-xs md:text-sm font-semibold text-brand-white/80"
        ><i class={`fa-solid ${producto.presentacion.icono} text-brand-gold mr-2`}></i>{producto.presentacion.texto}</span
      >
    </div>
    <a
      href={whatsappLink(producto.mensajeWhatsApp)}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full text-center bg-transparent border border-brand-gold/50 text-brand-gold hover:bg-brand-red hover:text-white hover:border-brand-red font-semibold py-3 rounded-sm transition-colors duration-300 uppercase text-xs tracking-widest block"
      >Consultar Precio</a
    >
  </div>
</div>
