---
/**
 * Sección "Nuestra Historia" (Tradición).
 *
 * Misma familia visual que el catálogo: fondo oscuro con luz cálida, anillo dorado
 * que gira con el scroll y titular blanco + dorado en cursiva.
 * - Al entrar: el retrato se abre en el arco, el titular sube línea por línea,
 *   el sello "10+" cae como un timbre y el texto aparece en cascada.
 * - Con el scroll: el anillo y el sello giran, la foto hace parallax y las barras
 *   del proceso "Del corte a tu cocina" se llenan de dorado paso a paso.
 */
import { site } from '../config/site';
import { whatsappLink } from '../lib/whatsapp';
import Button from './ui/Button.astro';

/** Pasos del proceso (se muestran en orden). */
const proceso = [
  { icono: 'fa-solid fa-bullseye', titulo: 'Selección', texto: 'Materias primas elegidas con rigor.' },
  { icono: 'fa-solid fa-utensils', titulo: 'Procesamiento', texto: 'Sabor y textura consistentes en cada lote.' },
  { icono: 'fa-solid fa-snowflake', titulo: 'Cadena de frío', texto: 'Calidad conservada desde la planta hasta tu local.' },
  { icono: 'fa-solid fa-handshake', titulo: 'Entrega y asesoría', texto: 'Logística puntual y atención personalizada para tu negocio.' },
];

const anios = '10+';
const selloTexto = `AÑOS DE EXPERIENCIA · ${site.slogan.toUpperCase()} · `;
---

<section id="nosotros" class="story" aria-labelledby="story-title" data-story>
  <div class="story-bg" aria-hidden="true"></div>

  <div class="story-inner">
    <div class="story-grid">
      <!-- Titular -->
      <div class="story-head">
        <h2 id="story-title" class="story-title font-heading font-bold text-brand-white">
          <span class="story-line"><span class="story-line-in">Más que proveedores,</span></span>
          <span class="story-line story-line--gold"><span class="story-line-in">somos socios estratégicos</span></span>
        </h2>
      </div>

      <!-- Retrato en arco + anillo + sello -->
      <div class="story-media">
        <div class="story-ring-wrap" aria-hidden="true">
          <svg class="story-ring" viewBox="0 0 200 200" fill="none">
            <circle cx="100" cy="100" r="99" stroke="currentColor" stroke-width="0.25" opacity="0.4"></circle>
            <circle cx="100" cy="100" r="93" stroke="currentColor" stroke-width="0.6" stroke-dasharray="0.4 2.2" opacity="0.45"></circle>
            <circle cx="1" cy="100" r="1.3" fill="currentColor"></circle>
            <circle cx="199" cy="100" r="1.3" fill="currentColor" opacity="0.5"></circle>
            <circle cx="100" cy="1" r="1.3" fill="currentColor" opacity="0.5"></circle>
          </svg>
        </div>

        <figure class="story-arch">
          <div class="story-photo">
            <img
              src="/images/cocinero.webp"
              alt={`Maestro carnicero de ${site.name} con mandil bordado y cuchillos en mano`}
              width="2816"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="story-arch-light" aria-hidden="true"></span>
        </figure>

        <div class="story-seal" role="img" aria-label="Más de 10 años de experiencia">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <defs>
              <path id="story-seal-path" d="M60,60 m-45,0 a45,45 0 1,1 90,0 a45,45 0 1,1 -90,0"></path>
            </defs>
            <circle cx="60" cy="60" r="58" class="story-seal-disc"></circle>
            <circle cx="60" cy="60" r="56" class="story-seal-edge"></circle>
            <circle cx="60" cy="60" r="34" class="story-seal-edge"></circle>
            <g class="story-seal-spin">
              <text class="story-seal-text">
                <textPath href="#story-seal-path" textLength="282" lengthAdjust="spacing">{selloTexto}</textPath>
              </text>
            </g>
            <text x="60" y="62" class="story-seal-num" text-anchor="middle" dominant-baseline="middle">{anios}</text>
          </svg>
        </div>
      </div>

      <!-- Texto -->
      <div class="story-copy">
        <p class="story-lead story-rise" style="--i: 0">
          En <strong>{site.name}</strong> sabemos que el éxito de tu cocina depende de la calidad de tus insumos. Por eso,
          desde hace <strong>más de 10 años</strong> procesamos y distribuimos productos cárnicos de alto estándar para el
          sector gastronómico.
        </p>
        <p class="story-text story-rise" style="--i: 1">
          Garantizamos un sabor y textura consistentes en cada lote, respaldados por una logística impecable que nunca dejará
          tu negocio desabastecido.
        </p>
        <div class="story-actions story-rise" style="--i: 2">
          <Button
            href={whatsappLink(site.whatsappMessages.general)}
            variant="primary"
            icon="fa-brands fa-whatsapp"
            trailingIcon="fa-solid fa-arrow-right"
            external
          >
            Habla con un asesor
          </Button>
        </div>
      </div>
    </div>

    <!-- Proceso -->
    <div class="story-process" data-story-process>
      <h3 class="story-process-title font-heading font-bold text-brand-white story-rise" style="--i: 0">
        Del corte <span class="italic font-normal text-brand-gold">a tu cocina</span>
      </h3>
      <ol class="story-steps">
        {
          proceso.map((paso, k) => (
            <li class="story-step story-rise" style={`--i: ${k + 1}; --f: 0`} data-step>
              <span class="story-step-bar" aria-hidden="true">
                <span class="story-step-fill" />
              </span>
              <i class={`${paso.icono} story-step-icon`} aria-hidden="true" />
              <h4 class="story-step-title font-heading font-bold">{paso.titulo}</h4>
              <p class="story-step-text">{paso.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* ==================================================================
     Base
  ================================================================== */
  .story {
    --p: 0; /* progreso del scroll a través de la sección (0 → 1) */
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #0a0a0a;
  }

  /* Luz cálida (misma receta que el catálogo, ahora del lado del retrato) */
  .story-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 45% 40% at 26% 34%, rgb(142 22 0 / 0.2), transparent 70%);
  }

  .story-inner {
    max-width: 80rem;
    margin-inline: auto;
    padding: 6rem 1rem 5rem;
  }

  @media (min-width: 640px) {
    .story-inner {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .story-inner {
      padding: 8.5rem 2rem 7rem;
    }
  }

  /* ==================================================================
     Rejilla: móvil = titular, retrato, texto. Escritorio = retrato a la
     izquierda; titular y texto a la derecha.
  ================================================================== */
  .story-grid {
    display: grid;
    gap: 2.75rem;
  }

  @media (min-width: 1024px) {
    .story-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      column-gap: 5.5rem;
      row-gap: 2.25rem;
      align-items: start;
    }

    .story-media {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .story-head {
      grid-column: 2;
      grid-row: 1;
      padding-top: 2.5rem;
    }

    .story-copy {
      grid-column: 2;
      grid-row: 2;
    }
  }

  /* ==================================================================
     Titular
  ================================================================== */
  .story-title {
    font-size: clamp(2.5rem, 4.6vw, 4.1rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .story-line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em 0.12em;
    margin-block: -0.06em -0.12em;
  }

  .story-line-in {
    display: block;
  }

  .story-line--gold .story-line-in {
    color: var(--gold);
    font-style: italic;
    font-weight: 600;
  }

  /* ==================================================================
     Retrato en arco
  ================================================================== */
  .story-media {
    position: relative;
    width: min(100%, 22rem);
    margin-inline: auto;
  }

  @media (min-width: 1024px) {
    .story-media {
      width: min(100%, 27rem);
      margin-inline: 0 auto;
    }
  }

  /* Resplandor detrás del arco */
  .story-media::before {
    content: '';
    position: absolute;
    inset: -25% -30%;
    z-index: -1;
    background:
      radial-gradient(circle at 50% 42%, rgb(197 160 89 / 0.14), transparent 40%),
      radial-gradient(circle at 50% 50%, rgb(142 22 0 / 0.32), transparent 60%);
    pointer-events: none;
  }

  .story-ring-wrap {
    position: absolute;
    left: 50%;
    top: 46%;
    width: 132%;
    aspect-ratio: 1;
    translate: -50% -50%;
    z-index: -1;
    color: var(--gold);
    pointer-events: none;
  }

  .story-ring {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: rotate(calc((var(--p) - 0.5) * 80deg));
  }

  .story-arch {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 999px 999px 6px 6px;
    background: #2a2420;
    box-shadow:
      0 40px 80px -30px rgb(0 0 0 / 0.9),
      inset 0 0 0 1px rgb(197 160 89 / 0.25);
  }

  .story-photo {
    position: absolute;
    inset: -8% 0;
    transform: translate3d(0, calc((var(--p) - 0.5) * -10%), 0);
  }

  .story-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 49% 30%;
  }

  /* Luz cálida sobre la foto de estudio: viñeta, tono ámbar y fundido inferior */
  .story-arch-light {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 55%, rgb(10 10 10 / 0.7) 100%),
      radial-gradient(ellipse 75% 65% at 50% 32%, transparent 45%, rgb(38 16 6 / 0.6) 100%),
      linear-gradient(rgb(196 128 64 / 0.16), rgb(196 128 64 / 0.16));
    box-shadow: inset 0 0 0 1px rgb(197 160 89 / 0.25);
    border-radius: inherit;
    pointer-events: none;
  }

  /* ==================================================================
     Sello "10+"
  ================================================================== */
  .story-seal {
    position: absolute;
    right: -0.75rem;
    bottom: 1.5rem;
    width: 7rem;
    border-radius: 50%;
    /* box-shadow y no filter: el texto del sello gira con el scroll */
    box-shadow: 0 14px 26px rgb(0 0 0 / 0.6);
  }

  @media (min-width: 1024px) {
    .story-seal {
      right: -3rem;
      bottom: 3rem;
      width: 9rem;
    }
  }

  .story-seal svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .story-seal-disc {
    fill: #0d0b0a;
  }

  .story-seal-edge {
    fill: none;
    stroke: var(--gold);
    stroke-width: 0.6;
    opacity: 0.7;
  }

  .story-seal-spin {
    transform-origin: 60px 60px;
    transform: rotate(calc(var(--p) * -160deg));
  }

  .story-seal-text {
    fill: var(--gold);
    font-family: Inter, sans-serif;
    font-size: 8.2px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .story-seal-num {
    fill: var(--gold);
    font-family: 'Playfair Display', serif;
    font-size: 30px;
    font-weight: 700;
  }

  /* ==================================================================
     Texto
  ================================================================== */
  .story-copy {
    max-width: 38rem;
  }

  .story-lead {
    font-size: 1.125rem;
    line-height: 1.65;
    font-weight: 300;
    color: rgb(249 250 251 / 0.86);
  }

  @media (min-width: 1024px) {
    .story-lead {
      font-size: 1.25rem;
    }
  }

  .story-lead strong {
    font-weight: 500;
    color: #f9fafb;
  }

  .story-text {
    margin-top: 1.25rem;
    font-size: 1rem;
    line-height: 1.7;
    font-weight: 300;
    color: #9ca3af;
  }

  @media (min-width: 1024px) {
    .story-text {
      font-size: 1.0625rem;
    }
  }

  .story-actions {
    margin-top: 2.25rem;
  }

  @media (max-width: 639px) {
    .story-actions :global(.btn) {
      width: 100%;
    }

    .story-actions :global(.btn-trail) {
      margin-left: auto;
    }
  }

  /* ==================================================================
     Proceso "Del corte a tu cocina"
  ================================================================== */
  .story-process {
    margin-top: 5rem;
  }

  @media (min-width: 1024px) {
    .story-process {
      margin-top: 7rem;
    }
  }

  .story-process-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.1;
  }

  .story-steps {
    display: grid;
    gap: 2rem;
    margin-top: 2.25rem;
  }

  @media (min-width: 640px) {
    .story-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
      row-gap: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .story-steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }

  /* Barra de avance (como el riel del catálogo) */
  .story-step-bar {
    position: relative;
    display: block;
    height: 2px;
    margin-bottom: 1.5rem;
    background: rgb(255 255 255 / 0.1);
    overflow: hidden;
  }

  .story-step-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #8e1600, var(--gold) 70%, var(--gold-hi));
    transform-origin: left;
    transform: scaleX(var(--f));
  }

  .story-step-icon {
    display: inline-block;
    font-size: 1.25rem;
    transform-origin: left center;
    color: rgb(197 160 89 / 0.45);
    transition:
      color 0.5s ease,
      transform 0.6s var(--ease-out);
  }

  .story-step-title {
    margin-top: 0.9rem;
    font-size: 1.375rem;
    line-height: 1.2;
    color: rgb(249 250 251 / 0.6);
    transition: color 0.5s ease;
  }

  .story-step-text {
    margin-top: 0.5rem;
    max-width: 30ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    font-weight: 300;
    color: #9ca3af;
  }

  /* Paso alcanzado: se enciende */
  .story-step[data-lit] .story-step-icon {
    color: var(--gold);
    transform: translateY(-2px) scale(1.08);
  }

  .story-step[data-lit] .story-step-title {
    color: #f9fafb;
  }

  /* ==================================================================
     Entrada (solo con JS; sin JS todo se ve directamente)
  ================================================================== */
  :global(html.js) .story:not([data-in]) .story-line-in {
    transform: translateY(105%) rotate(2deg);
  }

  .story-line-in {
    transition: transform 1.1s var(--ease-out);
  }

  .story-line--gold .story-line-in {
    transition-delay: 0.15s;
  }

  /* Arco: se abre de abajo hacia arriba y la foto se asienta */
  :global(html.js) .story:not([data-in]) .story-arch {
    clip-path: inset(100% 0 0 0 round 999px 999px 6px 6px);
  }

  .story-arch {
    clip-path: inset(0 0 0 0 round 999px 999px 6px 6px);
    transition: clip-path 1.3s var(--ease-in-out) 0.1s;
  }

  :global(html.js) .story:not([data-in]) .story-photo img {
    transform: scale(1.18);
  }

  .story-photo img {
    transition: transform 1.8s var(--ease-out) 0.1s;
  }

  /* Anillo: aparece girando */
  :global(html.js) .story:not([data-in]) .story-ring-wrap {
    opacity: 0;
    rotate: -40deg;
    scale: 0.9;
  }

  .story-ring-wrap {
    transition:
      opacity 1.2s ease 0.3s,
      rotate 1.8s var(--ease-out) 0.3s,
      scale 1.8s var(--ease-out) 0.3s;
  }

  /* Sello: cae como un timbre (como el logo del navbar) */
  :global(html.js) .story:not([data-in]) .story-seal {
    opacity: 0;
    scale: 2.2;
    rotate: -25deg;
  }

  .story-seal {
    transition:
      opacity 0.35s ease 1s,
      scale 0.8s var(--ease-out) 1s,
      rotate 0.8s var(--ease-out) 1s;
  }

  /* Texto y pasos: cascada (como el texto del catálogo) */
  :global(html.js) .story:not([data-in]) .story-copy .story-rise,
  :global(html.js) .story-process:not([data-in]) .story-rise {
    opacity: 0;
    transform: translateY(22px);
  }

  .story-rise {
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.9s var(--ease-out);
    transition-delay: calc(0.45s + var(--i, 0) * 0.1s);
  }

  .story-process .story-rise {
    transition-delay: calc(var(--i, 0) * 0.1s);
  }

  /* ==================================================================
     Movimiento reducido
  ================================================================== */
  @media (prefers-reduced-motion: reduce) {
    .story-line-in,
    .story-arch,
    .story-photo img,
    .story-ring-wrap,
    .story-seal,
    .story-rise,
    .story-step-icon,
    .story-step-title {
      transition: none !important;
    }

    :global(html.js) .story .story-line-in,
    :global(html.js) .story .story-photo img,
    :global(html.js) .story .story-rise {
      transform: none !important;
      opacity: 1 !important;
    }

    :global(html.js) .story .story-arch {
      clip-path: inset(0 0 0 0 round 999px 999px 6px 6px) !important;
    }

    :global(html.js) .story .story-ring-wrap,
    :global(html.js) .story .story-seal {
      opacity: 1 !important;
      rotate: none !important;
      scale: none !important;
    }

    .story-ring,
    .story-photo,
    .story-seal-spin {
      transform: none;
    }

    .story-step-fill {
      transform: none;
    }
  }
</style>

<script>
  const story = document.querySelector<HTMLElement>('[data-story]');
  const process = document.querySelector<HTMLElement>('[data-story-process]');
  const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (story && process) {
    // ---------- Entrada (una sola vez) ----------
    const reveal = (el: HTMLElement, amount: number) =>
      new IntersectionObserver(
        (entries, obs) => {
          if (entries.some((e) => e.isIntersecting)) {
            el.setAttribute('data-in', '');
            obs.disconnect();
          }
        },
        { threshold: amount },
      ).observe(el);

    reveal(story, 0.2);
    reveal(process, 0.35);

    // ---------- Scroll: anillo, sello, parallax y barras del proceso ----------
    if (reduceMotion) {
      steps.forEach((s) => {
        s.style.setProperty('--f', '1');
        s.setAttribute('data-lit', '');
      });
    } else {
      let ticking = false;
      const update = () => {
        ticking = false;
        const vh = window.innerHeight;
        const r = story.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height)));
        story.style.setProperty('--p', p.toFixed(4));

        // Las barras se llenan mientras el proceso sube del 90% al 40% de la pantalla
        const pr = process.getBoundingClientRect();
        const fill = Math.min(1, Math.max(0, (vh * 0.9 - pr.top) / (vh * 0.5)));
        steps.forEach((s, k) => {
          const f = Math.min(1, Math.max(0, fill * steps.length - k));
          s.style.setProperty('--f', f.toFixed(3));
          s.toggleAttribute('data-lit', f > 0.6);
        });
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      // Solo escucha el scroll mientras la sección está cerca de la pantalla
      new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            window.addEventListener('scroll', onScroll, { passive: true });
            update();
          } else {
            window.removeEventListener('scroll', onScroll);
          }
        },
        { rootMargin: '20% 0px' },
      ).observe(story);
      window.addEventListener('resize', onScroll);
    }
  }
</script>
