---
/**
 * Sección "¿Qué negocio vas a abastecer?".
 * El visitante elige su tipo de negocio y los productos recomendados se
 * "reparten" sobre el mostrador, con un botón de WhatsApp que arma el pedido.
 *
 * Los tipos de negocio se editan en src/data/negocios.ts
 */
import { negocios } from '../data/negocios';
import { productos, nombreCompleto } from '../data/productos';
import { site } from '../config/site';
import { whatsappLink } from '../lib/whatsapp';
import Button from './ui/Button.astro';

/** Posición de cada producto sobre el mostrador según cuántos haya (2 o 3). */
const layouts: Record<number, { x: string; y: string; r: string; s: number; z: number }[]> = {
  2: [
    { x: '6%', y: '10%', r: '-7deg', s: 0.92, z: 1 },
    { x: '42%', y: '6%', r: '6deg', s: 1, z: 2 },
  ],
  3: [
    { x: '0%', y: '16%', r: '-10deg', s: 0.8, z: 1 },
    { x: '24%', y: '2%', r: '0deg', s: 1, z: 3 },
    { x: '50%', y: '18%', r: '9deg', s: 0.84, z: 2 },
  ],
};
---

<section id="negocios" class="biz" aria-labelledby="biz-title" data-biz>
  <div class="biz-inner">
    <header class="biz-head">
      <h2 id="biz-title" class="biz-title font-heading font-bold">
        <span class="biz-line"><span class="biz-line-in">¿Qué negocio</span></span>
        <span class="biz-line biz-line--gold"><span class="biz-line-in">vas a abastecer?</span></span>
      </h2>
      <p class="biz-lead biz-rise" style="--i: 0">
        Elige tu tipo de negocio y te mostramos los productos que mejor le rinden.
      </p>
    </header>

    <div class="biz-body">
      <!-- Selector de negocio -->
      <div class="biz-tabs no-scrollbar" role="tablist" aria-label="Tipo de negocio" data-biz-tabs>
        {
          negocios.map((n, i) => (
            <button
              type="button"
              class="biz-tab biz-rise"
              role="tab"
              id={`biz-tab-${n.id}`}
              aria-controls={`biz-panel-${n.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              style={`--i: ${i + 1}`}
              data-biz-tab={i}
            >
              <i class={`${n.icono} biz-tab-icon`} aria-hidden="true" />
              <span class="biz-tab-label">{n.nombre}</span>
              <i class="fa-solid fa-arrow-right biz-tab-arrow" aria-hidden="true" />
            </button>
          ))
        }
      </div>

      <!-- Paneles: productos sobre el mostrador -->
      <div class="biz-panels">
        {
          negocios.map((n, i) => {
            const lista = n.productos.map((k) => productos[k]);
            const nombres = lista.map(nombreCompleto);
            const pos = layouts[lista.length] ?? layouts[3];
            return (
              <div
                class="biz-panel"
                role="tabpanel"
                id={`biz-panel-${n.id}`}
                aria-labelledby={`biz-tab-${n.id}`}
                data-biz-panel={i}
                data-active={i === 0 ? '' : undefined}
              >
                <h3 class="biz-panel-title font-heading font-bold">{n.nombre}</h3>

                <div class="biz-stage" aria-hidden="true">
                  <div class="biz-spot" />
                  <div class="biz-counter" />
                  {lista.map((p, k) => (
                    <img
                      class="biz-prod"
                      src={encodeURI(p.imagen)}
                      alt=""
                      width="2048"
                      height="2048"
                      loading="lazy"
                      decoding="async"
                      style={`--x: ${pos[k].x}; --y: ${pos[k].y}; --r: ${pos[k].r}; --s: ${pos[k].s}; --k: ${k}; z-index: ${pos[k].z}`}
                    />
                  ))}
                </div>

                <div class="biz-info">
                  <p class="biz-text">{n.texto}</p>
                  <p class="biz-list">
                    <span class="sr-only">Productos recomendados: </span>
                    {nombres.map((nombre, k) => (
                      <span class="biz-list-item">
                        {k > 0 && <span class="biz-list-dot" aria-hidden="true" />}
                        {nombre}
                      </span>
                    ))}
                  </p>
                  <Button
                    href={whatsappLink(site.whatsappMessages.negocio(n.quien, nombres))}
                    variant="gold"
                    icon="fa-brands fa-whatsapp"
                    trailingIcon="fa-solid fa-arrow-right"
                    external
                    sublabel={`Para mi ${n.boton}`}
                    class="biz-cta"
                  >
                    Cotizar por WhatsApp
                  </Button>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ==================================================================
     Campo rojo de la marca (rompe la secuencia de fondos oscuros)
  ================================================================== */
  .biz {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #fbf3ea;
    background:
      radial-gradient(ellipse 55% 60% at 72% 48%, rgb(176 36 6 / 0.55), transparent 70%),
      linear-gradient(180deg, #5c0d00 0%, #6f1100 45%, #4a0a00 100%);
  }

  .biz-inner {
    max-width: 80rem;
    margin-inline: auto;
    padding: 5.5rem 1rem 5rem;
  }

  @media (min-width: 640px) {
    .biz-inner {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .biz-inner {
      padding: 7.5rem 2rem 7rem;
    }
  }

  /* ---------- Titular ---------- */
  .biz-title {
    font-size: clamp(2.5rem, 5.4vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #fbf3ea;
  }

  .biz-line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em 0.12em;
    margin-block: -0.06em -0.12em;
  }

  .biz-line-in {
    display: block;
    transition: transform 1.1s var(--ease-out);
  }

  .biz-line--gold .biz-line-in {
    color: #e2bd73;
    font-style: italic;
    font-weight: 600;
    transition-delay: 0.15s;
  }

  .biz-lead {
    max-width: 34rem;
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    font-weight: 300;
    color: rgb(251 243 234 / 0.82);
  }

  @media (min-width: 1024px) {
    .biz-lead {
      font-size: 1.1875rem;
    }
  }

  /* ---------- Cuerpo: selector + paneles ---------- */
  .biz-body {
    margin-top: 2.5rem;
  }

  /* Escritorio: titular y selector a la izquierda; mostrador a la derecha */
  @media (min-width: 1024px) {
    .biz-inner {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      column-gap: 4rem;
    }

    .biz-body {
      display: contents;
    }

    .biz-head {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .biz-tabs {
      grid-column: 1;
      grid-row: 2;
      align-self: center;
      margin-top: 2rem !important;
    }

    .biz-panels {
      grid-column: 2;
      grid-row: 2;
      align-self: center;
      margin-top: -2rem;
    }
  }

  /* Selector: chips deslizables en móvil, índice grande en escritorio */
  .biz-tabs {
    display: flex;
    gap: 0.5rem;
    margin-inline: -1rem;
    padding: 0.25rem 1rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
  }

  @media (min-width: 1024px) {
    .biz-tabs {
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
  }

  .biz-tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
    scroll-snap-align: start;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.22);
    color: rgb(251 243 234 / 0.75);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.35s ease,
      color 0.35s ease;
  }

  .biz-tab-icon {
    font-size: 0.9rem;
    color: #e2bd73;
  }

  .biz-tab-arrow {
    display: none;
  }

  .biz-tab[aria-selected='true'] {
    background: #fbf3ea;
    color: #3d0900;
  }

  .biz-tab[aria-selected='true'] .biz-tab-icon {
    color: #8e1600;
  }

  .biz-tab:focus-visible {
    outline: 2px solid #e2bd73;
    outline-offset: 3px;
  }

  @media (min-width: 1024px) {
    .biz-tab {
      gap: 1rem;
      width: 100%;
      padding: 1rem 0;
      border-radius: 0;
      background: none;
      color: rgb(251 243 234 / 0.5);
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.6rem, 2.3vw, 2.25rem);
      font-weight: 700;
      line-height: 1.1;
      white-space: normal;
      text-align: left;
      transition:
        color 0.35s ease,
        padding-left 0.5s var(--ease-out);
    }

    .biz-tab-icon {
      width: 1.5rem;
      font-size: 1.1rem;
      opacity: 0.6;
      transition: opacity 0.35s ease;
    }

    .biz-tab-arrow {
      display: block;
      margin-left: auto;
      font-size: 1.1rem;
      color: #e2bd73;
      opacity: 0;
      transform: translateX(-12px);
      transition:
        opacity 0.35s ease,
        transform 0.5s var(--ease-out);
    }

    .biz-tab:hover {
      color: rgb(251 243 234 / 0.85);
    }

    .biz-tab[aria-selected='true'] {
      background: none;
      color: #fbf3ea;
      padding-left: 0.75rem;
    }

    .biz-tab[aria-selected='true'] .biz-tab-label {
      font-style: italic;
      color: #e2bd73;
    }

    .biz-tab[aria-selected='true'] .biz-tab-icon {
      color: #e2bd73;
      opacity: 1;
    }

    .biz-tab[aria-selected='true'] .biz-tab-arrow {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Paneles apilados en la misma celda ---------- */
  .biz-panels {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: 1.5rem;
  }

  @media (min-width: 1024px) {
    .biz-panels {
      margin-top: 0;
    }
  }

  .biz-panel {
    grid-area: 1 / 1;
  }

  .biz-panel-title {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  /* Con JS: un panel a la vez y el título lo da la pestaña */
  :global(html.js) .biz-panel-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  :global(html.js) .biz-panel {
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 0.4s;
  }

  :global(html.js) .biz-panel[data-active] {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  /* Sin JS: los paneles se muestran uno debajo de otro */
  :global(html:not(.js)) .biz-panel {
    grid-area: auto;
    margin-bottom: 3rem;
  }

  /* ---------- Mostrador con productos ---------- */
  .biz-stage {
    position: relative;
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
    aspect-ratio: 16 / 10;
  }

  .biz-spot {
    position: absolute;
    inset: -10% 5% 0;
    background: radial-gradient(closest-side, rgb(255 214 170 / 0.2), transparent);
  }

  .biz-counter {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 2%;
    height: 18%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(30 4 0 / 0.75), rgb(30 4 0 / 0.3) 60%, transparent);
  }

  .biz-prod {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 52%;
    height: auto;
    transform: rotate(var(--r)) scale(var(--s));
  }

  /* Reparto: los productos llegan girando al mostrador, uno tras otro */
  :global(html.js) .biz-panel .biz-prod {
    opacity: 0;
    transform: translate3d(0, 28%, 0) rotate(calc(var(--r) - 22deg)) scale(calc(var(--s) * 0.78));
    transition:
      opacity 0.25s ease,
      transform 0.35s ease;
  }

  :global(html.js) .biz-panel[data-active] .biz-prod {
    opacity: 1;
    transform: rotate(var(--r)) scale(var(--s));
    transition:
      opacity 0.5s ease calc(0.1s + var(--k) * 0.1s),
      transform 0.9s var(--ease-out) calc(0.1s + var(--k) * 0.1s);
  }

  /* Hasta que la sección entra en pantalla, el mostrador espera vacío */
  :global(html.js) .biz:not([data-in]) .biz-panel[data-active] .biz-prod {
    opacity: 0;
    transform: translate3d(0, 28%, 0) rotate(calc(var(--r) - 22deg)) scale(calc(var(--s) * 0.78));
  }

  /* ---------- Texto del panel ---------- */
  .biz-info {
    max-width: 36rem;
    margin: 0.5rem auto 0;
    text-align: center;
  }

  .biz-text {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgb(251 243 234 / 0.9);
  }

  .biz-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 0;
    margin-top: 0.9rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #e2bd73;
  }

  .biz-list-item {
    display: inline-flex;
    align-items: center;
  }

  .biz-list-dot {
    width: 4px;
    height: 4px;
    margin-inline: 0.75rem;
    border-radius: 50%;
    background: rgb(226 189 115 / 0.6);
  }

  .biz-info :global(.biz-cta) {
    margin-top: 1.5rem;
  }

  :global(html.js) .biz-panel .biz-info {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.2s ease,
      transform 0.3s ease;
  }

  :global(html.js) .biz-panel[data-active] .biz-info {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease-out) 0.35s,
      transform 0.7s var(--ease-out) 0.35s;
  }

  @media (max-width: 639px) {
    .biz-info :global(.biz-cta) {
      width: 100%;
    }

    .biz-info :global(.btn-trail) {
      margin-left: auto;
    }
  }

  /* ==================================================================
     Entrada de la sección
  ================================================================== */
  :global(html.js) .biz:not([data-in]) .biz-line-in {
    transform: translateY(105%) rotate(2deg);
  }

  :global(html.js) .biz:not([data-in]) .biz-rise {
    opacity: 0;
    transform: translateY(18px);
  }

  .biz-rise {
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.9s var(--ease-out),
      background-color 0.35s ease,
      color 0.35s ease,
      padding-left 0.5s var(--ease-out);
    transition-delay: calc(0.3s + var(--i, 0) * 0.07s);
  }

  /* Tras la entrada, las pestañas responden sin retraso */
  :global(html.js) .biz[data-settled] .biz-rise {
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .biz-line-in,
    .biz-rise,
    .biz-prod,
    .biz-info,
    .biz-tab,
    .biz-tab-arrow {
      transition: none !important;
    }

    :global(html.js) .biz .biz-line-in,
    :global(html.js) .biz .biz-rise {
      transform: none !important;
      opacity: 1 !important;
    }

    :global(html.js) .biz .biz-panel[data-active] .biz-prod {
      opacity: 1 !important;
      transform: rotate(var(--r)) scale(var(--s)) !important;
    }
  }
</style>

<script>
  const biz = document.querySelector<HTMLElement>('[data-biz]');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-biz-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-biz-panel]'));

  if (biz && tabs.length) {
    let current = 0;

    const select = (i: number, focus = false) => {
      if (i === current) return;
      current = i;
      tabs.forEach((t, k) => {
        const on = k === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p, k) => p.toggleAttribute('data-active', k === i));
      const tab = tabs[i];
      if (focus) tab.focus();
      // En móvil, centra la pestaña elegida en la fila deslizable
      const row = tab.parentElement;
      if (row && row.scrollWidth > row.clientWidth) {
        row.scrollTo({ left: tab.offsetLeft - (row.clientWidth - tab.offsetWidth) / 2, behavior: 'smooth' });
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
    });

    // Escritorio: pasar el mouse también cambia (con una pequeña espera para no parpadear)
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let timer = 0;
      tabs.forEach((tab, i) => {
        tab.addEventListener('pointerenter', () => {
          clearTimeout(timer);
          timer = window.setTimeout(() => select(i), 140);
        });
        tab.addEventListener('pointerleave', () => clearTimeout(timer));
      });
    }

    // Teclado: flechas, Inicio y Fin
    biz.querySelector('[data-biz-tabs]')?.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      const keys: Record<string, number> = {
        ArrowDown: current + 1,
        ArrowRight: current + 1,
        ArrowUp: current - 1,
        ArrowLeft: current - 1,
        Home: 0,
        End: tabs.length - 1,
      };
      if (!(ev.key in keys)) return;
      ev.preventDefault();
      select((keys[ev.key] + tabs.length) % tabs.length, true);
    });

    // Entrada al aparecer en pantalla
    new IntersectionObserver(
      (entries, obs) => {
        if (entries.some((en) => en.isIntersecting)) {
          biz.setAttribute('data-in', '');
          setTimeout(() => biz.setAttribute('data-settled', ''), 1400);
          obs.disconnect();
        }
      },
      { threshold: 0.25 },
    ).observe(biz);
  }
</script>
